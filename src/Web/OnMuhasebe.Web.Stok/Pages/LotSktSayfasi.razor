@page "/stok/lotlar"
@inject ApiIstemcisi Api
@inject NavigationManager Navigasyon
@inject TimeProvider Zaman

<SayfaBasligi Baslik="Lot / SKT ve Seri Takibi" GeriAdres="stok" Ikon="@Icons.Material.Filled.QrCode2"
              AltBaslik="Stoktaki lotlar son kullanma sırasıyla; seri numarasının giriş-çıkış geçmişi (geri çağırma, garanti, iade)" />

<HataGosterimi Hata="_hata" />

<div class="tur-sekmeleri belirme">
    @foreach (var (etiket, gun) in new (string, int?)[] { ("Tüm lotlar", null), ("SKT 30 gün içinde", 30), ("SKT 90 gün içinde", 90), ("SKT geçmiş", 0) })
    {
        <button type="button" class="tur-sekmesi @(_gun == gun ? "secili" : "")" style="--vurgu:@(gun is null ? "#14B8A6" : gun == 0 ? "#EF4444" : "#F59E0B")"
                @onclick="() => FiltreAsync(() => _gun = gun)">@etiket</button>
    }
</div>

<FiltreCubugu>
    <MudItem xs="12" md="5">
        <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Value="_arama" ValueChanged="a => FiltreAsync(() => _arama = a)"
                      Placeholder="Ürün adı, kodu ya da lot no" DebounceInterval="400" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    </MudItem>
    <MudItem xs="12" md="4">
        <MudSelect T="Guid?" Variant="Variant.Outlined" Margin="Margin.Dense" Value="_depoId" ValueChanged="d => FiltreAsync(() => _depoId = d)" Label="Depo" Clearable="true">
            @foreach (var d in _depolar)
            {
                <MudSelectItem T="Guid?" Value="d.Id">@d.Ad</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</FiltreCubugu>

<VeriTablosu T="LotBakiyesi" Kayitlar="_sonuc?.Kayitlar" Yukleniyor="_yukleniyor" Sayfa="_sayfa" ToplamSayfa="_sonuc?.ToplamSayfa ?? 0" SayfaDegisti="SayfaAsync"
             SatirTiklandi="@(l => Navigasyon.NavigateTo($"stok/{l.StokKartiId}"))" Dense="true"
             BosIkon="@Icons.Material.Outlined.QrCode2" BosBaslik="Lot bulunamadı" BosAciklama="Lot/seri izlenen ürünlerin girişleri burada listelenir.">
    <Basliklar>
        <MudTh>Ürün</MudTh>
        <MudTh>Lot</MudTh>
        <MudTh>Depo</MudTh>
        <MudTh>Son kullanma</MudTh>
        <MudTh Class="sayi">Miktar</MudTh>
    </Basliklar>
    <Satir>
        @{
            var durum = IzlenebilirlikKurallari.Durum(context.SonKullanmaTarihi, _bugun);
        }
        <MudTd DataLabel="Ürün"><b>@context.StokAdi</b> <span class="mobil-alt-bilgi">@context.StokKodu</span></MudTd>
        <MudTd DataLabel="Lot">@context.LotNo</MudTd>
        <MudTd DataLabel="Depo">@context.DepoAdi</MudTd>
        <MudTd DataLabel="Son kullanma">
            @if (context.SonKullanmaTarihi is { } skt)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                         Color="@(durum == SktDurumu.Gecmis ? Color.Error : durum == SktDurumu.Yaklasiyor ? Color.Warning : Color.Default)">
                    @Bicim.Tarih(skt) · @(durum == SktDurumu.Gecmis ? $"{_bugun.DayNumber - skt.DayNumber} gün geçti" : $"{skt.DayNumber - _bugun.DayNumber} gün")
                </MudChip>
            }
            else
            {
                <span style="opacity:.6">—</span>
            }
        </MudTd>
        <MudTd DataLabel="Miktar" Class="sayi"><b>@Bicim.Miktar(context.Miktar, context.TemelBirim)</b></MudTd>
    </Satir>
</VeriTablosu>

<div class="panel-kart kart belirme mt-4">
    <div class="panel-baslik"><MudIcon Icon="@Icons.Material.Filled.ManageSearch" Size="Size.Small" Color="Color.Secondary" /> Seri numarası sorgula</div>
    <div class="d-flex gap-2 align-center mb-2">
        <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_seri" Placeholder="Seri numarası" Style="max-width:320px"
                      OnKeyUp="@(async e => { if (e.Key == "Enter") await SeriSorgulaAsync(); })" />
        <MudButton Variant="Variant.Outlined" OnClick="SeriSorgulaAsync" Disabled="string.IsNullOrWhiteSpace(_seri)">Sorgula</MudButton>
    </div>
    @if (_seriGecmisi is { } gecmis)
    {
        @if (gecmis.Count == 0)
        {
            <div class="ozet-alt">Bu seri numarasıyla hareket bulunamadı.</div>
        }
        else
        {
            var net = gecmis.Sum(h => h.GirisMi ? 1 : -1);
            <div class="ozet-alt mb-2"><b>@gecmis[0].StokAdi</b> (@gecmis[0].StokKodu) · @(net > 0 ? "şu an stokta" : "stokta değil")</div>
            @foreach (var h in gecmis)
            {
                <div class="d-flex gap-3 py-1" style="@(h.IptalMi ? "opacity:.5" : "")">
                    <span style="min-width:90px">@Bicim.Tarih(h.Tarih)</span>
                    <span class="@(h.GirisMi ? "bakiye-alacakli" : "bakiye-borclu")" style="min-width:150px">@StokMetinleri.HareketTuru(h.Tur) @(h.GirisMi ? "↓" : "↑")</span>
                    <span style="min-width:120px">@h.DepoAdi</span>
                    <span style="flex:1">
                        @if (h.KaynakBelgeId is { } belgeId)
                        {
                            <BelgeBaglantisi KaynakBelgeId="belgeId" FaturaMi="StokMetinleri.FaturaHareketiMi(h.Tur)" Metin="@(h.BelgeNo ?? "Belge")" />
                        }
                        else
                        {
                            @h.BelgeNo
                        }
                        <small style="opacity:.7">@h.Aciklama @(h.LotNo is null ? "" : $"· lot {h.LotNo}")</small>
                    </span>
                </div>
            }
        }
    }
</div>

@code {
    private int? _gun;
    private string? _arama;
    private Guid? _depoId;
    private List<Depo> _depolar = [];
    private int _sayfa = 1;
    private bool _yukleniyor;
    private SayfaliSonuc<LotBakiyesi>? _sonuc;
    private string? _seri;
    private List<SeriHareketi>? _seriGecmisi;
    private DateOnly _bugun;
    private ApiHatasi? _hata;

    protected override async Task OnInitializedAsync()
    {
        _bugun = DateOnly.FromDateTime(Zaman.GetLocalNow().Date);
        var depolar = await Api.GetAsync<List<Depo>>("api/stok/depolar");
        _depolar = depolar.BasariliMi ? depolar.Deger : [];
        await YukleAsync();
    }

    private async Task YukleAsync()
    {
        _yukleniyor = true;
        var adres = $"api/stok/lotlar?sayfa={_sayfa}&arama={Uri.EscapeDataString(_arama ?? "")}"
                    + (_gun is { } g ? $"&gun={g}" : "") + (_depoId is { } d ? $"&depoId={d}" : "");
        var sonuc = await Api.GetAsync<SayfaliSonuc<LotBakiyesi>>(adres);
        _hata = sonuc.Hata;
        _sonuc = sonuc.BasariliMi ? sonuc.Deger : null;
        _yukleniyor = false;
    }

    private async Task FiltreAsync(Action degistir)
    {
        degistir();
        _sayfa = 1;
        await YukleAsync();
    }

    private async Task SayfaAsync(int sayfa)
    {
        _sayfa = sayfa;
        await YukleAsync();
    }

    private async Task SeriSorgulaAsync()
    {
        var sonuc = await Api.GetAsync<List<SeriHareketi>>($"api/stok/seri-gecmisi?no={Uri.EscapeDataString(_seri!.Trim())}");
        _seriGecmisi = sonuc.BasariliMi ? sonuc.Deger : [];
    }
}
