@inject ApiIstemcisi Api
@inject ISnackbar Snackbar
@inject OnayServisi Onay
@inject OturumYoneticisi Oturum

<MudDialog>
    <DialogContent>
        <HataGosterimi Hata="_hata" />
        @if (Oturum.YazabilirMi(StokYetkileri.Tanim, YetkiIslemleri.Ekle))
        {
            <div class="d-flex gap-2 align-center mb-3">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="YeniAd" Immediate="true" Label="Yeni depo adı" MaxLength="100" OnKeyDown="TusAsync" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_yeniAd)" OnClick="EkleAsync">Ekle</MudButton>
            </div>
        }
        <MudList T="string" Dense="true">
            @foreach (var depo in _depolar)
            {
                <MudListItem T="string">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Warehouse" Size="Size.Small" Color="Color.Secondary" />
                        <div style="min-width:0">
                            <MudText>@depo.Ad</MudText>
                            <MudText Typo="Typo.caption" Style="opacity:.7">@(depo.TamAdres ?? "Adres girilmedi")</MudText>
                        </div>
                        @if (depo.VarsayilanMi)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">Varsayılan</MudChip>
                        }
                        <MudSpacer />
                        @if (Oturum.YazabilirMi(StokYetkileri.Tanim, YetkiIslemleri.Duzenle))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Düzenle" OnClick="() => DuzenlemeyiAc(depo)" />
                        }
                        @if (Oturum.YazabilirMi(StokYetkileri.Tanim, YetkiIslemleri.Duzenle) && !depo.VarsayilanMi)
                        {
                            <MudTooltip Text="Varsayılan yap">
                                <MudIconButton Icon="@Icons.Material.Outlined.StarOutline" Size="Size.Small" aria-label="Varsayılan yap" OnClick="() => VarsayilanYapAsync(depo)" />
                            </MudTooltip>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Sil" OnClick="() => SilAsync(depo)" />
                        }
                    </div>
                    @if (_duzenlenen == depo.Id)
                    {
                        <MudGrid Spacing="1" Class="mt-2">
                            <MudItem xs="12"><MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_ad" Label="Depo adı" MaxLength="100" /></MudItem>
                            <MudItem xs="12"><MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_adres" Label="Açık adres" MaxLength="500" /></MudItem>
                            <MudItem xs="6"><MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_ilce" Label="İlçe" MaxLength="50" /></MudItem>
                            <MudItem xs="6"><MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_il" Label="İl" MaxLength="50" /></MudItem>
                            <MudItem xs="12" Class="d-flex justify-end gap-2">
                                <MudButton Size="Size.Small" OnClick="() => _duzenlenen = null">Vazgeç</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_ad)"
                                           OnClick="() => GuncelleAsync(depo)">Kaydet</MudButton>
                            </MudItem>
                        </MudGrid>
                    }
                </MudListItem>
            }
        </MudList>
        <MudText Typo="Typo.caption" Class="mt-2 d-block" Style="opacity:.7">
            Hareket girilirken depo seçilmezse varsayılan depo kullanılır. Depo adresi, depolar arası sevk irsaliyesinde teslim adresi olarak kullanılır.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Close()">Kapat</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private List<Depo> _depolar = [];
    private string _yeniAd = "";
    private Guid? _duzenlenen;
    private string? _ad;
    private string? _adres;
    private string? _il;
    private string? _ilce;
    private ApiHatasi? _hata;

    private void DuzenlemeyiAc(Depo depo) => (_duzenlenen, _ad, _adres, _il, _ilce) = (depo.Id, depo.Ad, depo.Adres, depo.Il, depo.Ilce);

    private async Task GuncelleAsync(Depo depo)
    {
        var sonuc = await Api.PutAsync($"api/stok/depolar/{depo.Id}", new DepoKaydetIstegi(_ad!, _adres, _il, _ilce));
        _hata = sonuc.Hata;
        if (sonuc.BasariliMi)
        {
            _duzenlenen = null;
            await YukleAsync();
        }
    }

    // Yazarken butonun anlık güncellenmesi için Immediate; yalnızca boşluk yazılırsa alan temizlenir (buton pasif kalır).
    private string YeniAd
    {
        get => _yeniAd;
        set => _yeniAd = string.IsNullOrWhiteSpace(value) ? "" : value;
    }

    private async Task TusAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter" && !string.IsNullOrWhiteSpace(_yeniAd))
        {
            await EkleAsync();
        }
    }

    protected override Task OnInitializedAsync() => YukleAsync();

    private async Task YukleAsync()
    {
        var sonuc = await Api.GetAsync<List<Depo>>("api/stok/depolar");
        _depolar = sonuc.BasariliMi ? sonuc.Deger : [];
        _hata = sonuc.Hata;
    }

    private async Task EkleAsync()
    {
        var sonuc = await Api.PostAsync<Depo>("api/stok/depolar", new DepoKaydetIstegi(_yeniAd));
        _hata = sonuc.Hata;
        if (sonuc.BasariliMi)
        {
            _yeniAd = "";
            await YukleAsync();
        }
    }

    private async Task VarsayilanYapAsync(Depo depo)
    {
        var sonuc = await Api.PostAsync($"api/stok/depolar/{depo.Id}/varsayilan");
        _hata = sonuc.Hata;
        await YukleAsync();
    }

    private async Task SilAsync(Depo depo)
    {
        if (!await Onay.SorAsync("Depoyu sil", $"{depo.Ad} silinecek.", "Sil", tehlikeli: true))
        {
            return;
        }

        var sonuc = await Api.DeleteAsync($"api/stok/depolar/{depo.Id}");
        if (sonuc.BasariliMi)
        {
            Snackbar.Add($"{depo.Ad} silindi.", Severity.Success);
            await YukleAsync();
        }
        else
        {
            _hata = sonuc.Hata;
        }
    }
}
