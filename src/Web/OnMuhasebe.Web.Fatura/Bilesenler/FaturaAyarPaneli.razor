@* Ayarlar ekranındaki Fatura paneli. Ana uygulama bunu tip adıyla, modül lisanslıysa lazy yükleyip gösterir.
   Bolum verilirse yalnız o kısım çizilir (Seriler / Varsayilanlar / Kagit); kayıt yine tüm ayarı gönderir, görünmeyen alanlar olduğu gibi kalır. *@
@inject ApiIstemcisi Api
@inject ISnackbar Snackbar
@inject OturumYoneticisi Oturum
@inject TimeProvider Zaman

<FormBolumu Baslik="@Baslik.Ad" Aciklama="@Baslik.Aciklama" Ikon="@Baslik.Ikon" Sira="Sira">
    @if (_ayar is null)
    {
        <MudItem xs="12"><MudSkeleton Height="200px" SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" /></MudItem>
    }
    else
    {
        @if (Goster("Seriler"))
        {
        <MudItem xs="12" md="6">
            <div class="ayar-baslik">Kayıt akışı</div>
            <MudRadioGroup T="KayitAkisi" @bind-Value="_akis">
                @foreach (var akis in Enum.GetValues<KayitAkisi>())
                {
                    <div class="ayar-secenek @(_akis == akis ? "secili" : "")">
                        <MudRadio Value="akis" Color="Color.Secondary" Disabled="Oturum.SaltOkunurMu">@FaturaMetinleri.KayitAkisi(akis)</MudRadio>
                        <div class="ayar-aciklama">@FaturaMetinleri.KayitAkisiAciklamasi(akis)</div>
                    </div>
                }
            </MudRadioGroup>
        </MudItem>
        <MudItem xs="12" md="6">
            <div class="ayar-baslik">Numara serileri</div>
            <div class="ayar-aciklama mb-2">GİB biçiminde 3 karakter; numara seri + yıl + 9 haneli sıradan oluşur. Gelen faturaların numarasını karşı taraf verir.</div>
            @foreach (var (etiket, deger, ata) in Seriler)
            {
                <div class="seri-satiri">
                    <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@etiket" Value="deger" ValueChanged="ata"
                                  MaxLength="3" Immediate="true" Disabled="Oturum.SaltOkunurMu"
                                  Error="@(!SeriGecerliMi(deger))" ErrorText="3 harf veya rakam" Style="max-width:140px" />
                    <span class="fatura-no ornek-numara">@($"{deger.ToUpperInvariant()}{Zaman.GetLocalNow().Year}000000001")</span>
                </div>
            }
        </MudItem>
        }
        @if (Goster("Varsayilanlar"))
        {
        <MudItem xs="12" md="6">
            <div class="ayar-baslik">Yeni fatura varsayılanları</div>
            <MudSwitch T="bool" @bind-Value="_toptanKdvDahil" Color="Color.Secondary" Disabled="Oturum.SaltOkunurMu"
                       Label="Toptan satış ve alışta fiyatlar KDV dahil girilsin" />
            <MudSwitch T="bool" @bind-Value="_perakendeKdvDahil" Color="Color.Secondary" Disabled="Oturum.SaltOkunurMu"
                       Label="Perakende satışta fiyatlar KDV dahil girilsin" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudNumericField T="int" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_vadeGunu" Label="Varsayılan vade (gün)"
                             Min="0" Max="365" Disabled="Oturum.SaltOkunurMu" HelperText="Carinin kendi vadesi varsa o kullanılır; 0 = vade yok"
                             Style="max-width:260px" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_varsayilanAciklama" Lines="2" MaxLength="1000"
                          Label="Faturalara ön tanımlı açıklama" Disabled="Oturum.SaltOkunurMu"
                          HelperText="Yeni satış faturalarına önerilir; ör. banka hesap bilgileri, iade ve teslim koşulları" />
        </MudItem>
        }
        @if (Goster("Kagit"))
        {
        <MudItem xs="12" md="6">
            @if (Bolum is null)
            {
                <div class="ayar-baslik">Kağıt / PDF çıktı</div>
            }
            <MudSelect T="KagitSablonu" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_kagitSablonu" Label="Şablon" Disabled="Oturum.SaltOkunurMu">
                <MudSelectItem Value="KagitSablonu.Standart">Standart</MudSelectItem>
                <MudSelectItem Value="KagitSablonu.Kompakt">Kompakt (sık satırlı, uzun faturalar için)</MudSelectItem>
                <MudSelectItem Value="KagitSablonu.Dovizli">Dövizli (satırlarda TL karşılığı)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6" Class="d-flex flex-column justify-end">
            <MudSwitch T="bool" @bind-Value="_kagittaBankaBilgisi" Color="Color.Secondary" Disabled="Oturum.SaltOkunurMu"
                       Label="Banka hesaplarımızı (IBAN) faturanın altına bas" />
            <MudSwitch T="bool" @bind-Value="_kagittaImzaAlani" Color="Color.Secondary" Disabled="Oturum.SaltOkunurMu"
                       Label="Teslim eden / teslim alan imza alanı" />
        </MudItem>
        }
        @if (Goster("Seriler") && _ayar.KayitAkisi == KayitAkisi.TaslakOnay && _akis == KayitAkisi.DogrudanKayit)
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">Mevcut taslak faturalar taslak olarak kalır; fatura detayından onaylayabilirsiniz.</MudAlert>
            </MudItem>
        }
        <MudItem xs="12" Class="d-flex justify-end">
            <IslemDugmesi Islem="KaydetAsync" StartIcon="@Icons.Material.Filled.Save" Disabled="@(Oturum.SaltOkunurMu || !DegistiMi || !TumSerilerGecerliMi)">
                Fatura ayarlarını kaydet
            </IslemDugmesi>
        </MudItem>
    }
</FormBolumu>

@code {
    [Parameter] public int Sira { get; set; }
    [Parameter] public string? Bolum { get; set; }

    private bool Goster(string bolum) => Bolum is null || Bolum == bolum;

    private (string Ad, string Aciklama, string Ikon) Baslik => Bolum switch
    {
        "Seriler" => ("Kayıt akışı ve numara serileri", "Faturalar doğrudan mı kaydedilsin, taslak-onay mı; GİB biçiminde belge serileri", Icons.Material.Filled.Numbers),
        "Varsayilanlar" => ("Yeni fatura varsayılanları", "Fiyat girişi, vade ve faturaya önerilen açıklama", Icons.Material.Filled.ReceiptLong),
        "Kagit" => ("Kağıt / PDF çıktı", "Yazdırılan faturanın şablonu ve alt bilgileri", Icons.Material.Filled.Print),
        _ => ("Fatura", "Kayıt akışı, numara serileri ve yeni fatura varsayılanları", Icons.Material.Filled.ReceiptLong)
    };

    private FaturaAyarlari? _ayar;
    private KayitAkisi _akis;
    private string _toptanSeri = "";
    private string _perakendeSeri = "";
    private string _iadeSeri = "";
    private string _giderPusulasiSeri = "";
    private string _irsaliyeSeri = "";
    private string _serbestMeslekSeri = "";
    private KagitSablonu _kagitSablonu;
    private bool _kagittaBankaBilgisi;
    private bool _kagittaImzaAlani;
    private bool _toptanKdvDahil;
    private bool _perakendeKdvDahil;
    private int _vadeGunu;
    private string? _varsayilanAciklama;

    private IEnumerable<(string Etiket, string Deger, EventCallback<string> Ata)> Seriler =>
    [
        ("Toptan satış", _toptanSeri, EventCallback.Factory.Create<string>(this, s => _toptanSeri = s ?? "")),
        ("Perakende satış", _perakendeSeri, EventCallback.Factory.Create<string>(this, s => _perakendeSeri = s ?? "")),
        ("Alıştan iade", _iadeSeri, EventCallback.Factory.Create<string>(this, s => _iadeSeri = s ?? "")),
        ("Gider pusulası", _giderPusulasiSeri, EventCallback.Factory.Create<string>(this, s => _giderPusulasiSeri = s ?? "")),
        ("İrsaliye", _irsaliyeSeri, EventCallback.Factory.Create<string>(this, s => _irsaliyeSeri = s ?? "")),
        ("Serbest meslek makbuzu", _serbestMeslekSeri, EventCallback.Factory.Create<string>(this, s => _serbestMeslekSeri = s ?? ""))
    ];

    private FaturaAyarlari Yeni => new(_akis, _toptanSeri.ToUpperInvariant(), _perakendeSeri.ToUpperInvariant(), _iadeSeri.ToUpperInvariant(),
        _toptanKdvDahil, _perakendeKdvDahil, _vadeGunu, _giderPusulasiSeri.ToUpperInvariant(), _irsaliyeSeri.ToUpperInvariant(),
        string.IsNullOrWhiteSpace(_varsayilanAciklama) ? null : _varsayilanAciklama.Trim(), _serbestMeslekSeri.ToUpperInvariant(),
        _kagitSablonu, _kagittaBankaBilgisi, _kagittaImzaAlani);

    private bool DegistiMi => _ayar is not null && Yeni != _ayar;

    private bool TumSerilerGecerliMi => SeriGecerliMi(_toptanSeri) && SeriGecerliMi(_perakendeSeri) && SeriGecerliMi(_iadeSeri)
                                        && SeriGecerliMi(_giderPusulasiSeri) && SeriGecerliMi(_irsaliyeSeri)
                                        && SeriGecerliMi(_serbestMeslekSeri);

    private static bool SeriGecerliMi(string seri) => seri.Length == 3 && seri.All(char.IsAsciiLetterOrDigit);

    protected override async Task OnInitializedAsync()
    {
        var sonuc = await Api.GetAsync<FaturaAyarlari>("api/fatura/ayarlar");
        if (sonuc.BasariliMi)
        {
            Ayarla(sonuc.Deger);
        }
    }

    private void Ayarla(FaturaAyarlari a)
    {
        _ayar = a;
        (_akis, _toptanSeri, _perakendeSeri, _iadeSeri, _giderPusulasiSeri) = (a.KayitAkisi, a.ToptanSeri, a.PerakendeSeri, a.IadeSeri, a.GiderPusulasiSeri);
        (_irsaliyeSeri, _serbestMeslekSeri) = (a.IrsaliyeSeri, a.SerbestMeslekSeri);
        (_kagitSablonu, _kagittaBankaBilgisi, _kagittaImzaAlani) = (a.KagitSablonu, a.KagittaBankaBilgisi, a.KagittaImzaAlani);
        (_toptanKdvDahil, _perakendeKdvDahil, _vadeGunu, _varsayilanAciklama) = (a.ToptanKdvDahil, a.PerakendeKdvDahil, a.VarsayilanVadeGunu, a.VarsayilanAciklama);
    }

    private async Task KaydetAsync()
    {
        var sonuc = await Api.PutAsync<FaturaAyarlari>("api/fatura/ayarlar", Yeni);
        if (sonuc.BasariliMi)
        {
            Ayarla(sonuc.Deger);
            Snackbar.Add("Fatura ayarları kaydedildi.", Severity.Success);
        }
        else
        {
            Snackbar.Add(sonuc.Hata.Baslik, Severity.Error);
        }
    }
}
