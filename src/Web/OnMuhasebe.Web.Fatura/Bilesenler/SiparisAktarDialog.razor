@* İrsaliye/faturaya siparişten satır aktarımı: carinin açık siparişleri termin sırasıyla listelenir; satır seçilir, miktar kısmi girilebilir.
   Siparişten fazla teslim (tolerans) engellenmez. *@
@inject ApiIstemcisi Api

<MudDialog>
    <DialogContent>
        <HataGosterimi Hata="_hata" />
        @if (_yukleniyor)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Animation="Animation.Wave" />
        }
        else if (_secenekler.Count == 0)
        {
            <BosDurum Ikon="@Icons.Material.Outlined.ShoppingBag" Baslik="Açık sipariş yok"
                      Aciklama="Bu cariye ait, belgenin türüne uygun onaylı ve karşılanmamış sipariş bulunmuyor." />
        }
        else
        {
            @foreach (var grup in _secenekler.GroupBy(s => s.Satir.SiparisId))
            {
                var ilk = grup.First().Satir;
                <div class="aktarim-grubu">
                    <div class="d-flex align-center gap-2">
                        <MudCheckBox T="bool" Value="grup.All(s => s.Secili)" ValueChanged="v => GrupSec(grup.Key, v)" Size="Size.Small" Dense="true" Color="Color.Secondary" />
                        <b class="fatura-no">@(ilk.SiparisNo ?? "—")</b>
                        @if (ilk.TerminTarihi is { } termin)
                        {
                            <span style="opacity:.7">termin @Bicim.Tarih(termin)</span>
                        }
                    </div>
                    @foreach (var s in grup)
                    {
                        <div class="aktarim-satiri">
                            <MudCheckBox T="bool" @bind-Value="s.Secili" Size="Size.Small" Dense="true" Color="Color.Secondary" />
                            <span style="flex:1; min-width:0">@s.Satir.Ad <small style="opacity:.6">@s.Satir.StokKodu</small></span>
                            <MudNumericField T="decimal" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="s.Miktar" Min="0"
                                             HideSpinButtons="true" Disabled="!s.Secili" Style="max-width:120px"
                                             Adornment="Adornment.End" AdornmentText="@Birimler.Ad(s.Satir.Birim)"
                                             HelperText="@($"kalan {Bicim.Miktar(s.Satir.KalanMiktar)}")" />
                        </div>
                    }
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Vazgeç</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Aktar" Disabled="!GecerliMi">
            @(_secenekler.Count(s => s.Secili) is var n and > 0 ? $"{n} satırı aktar" : "Aktar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid CariId { get; set; }
    [Parameter, EditorRequired] public TeklifSiparisTuru SiparisTuru { get; set; }

    // İrsaliyeye yalnızca ürün satırları aktarılır.
    [Parameter] public bool YalnizcaUrun { get; set; }

    // Verilirse yalnızca bu siparişin satırları seçili gelir (siparişten belge oluşturma).
    [Parameter] public Guid? SeciliSiparis { get; set; }

    // Formda zaten bulunan sipariş satırları listelenmez.
    [Parameter] public IReadOnlyCollection<Guid> Mevcutlar { get; set; } = [];

    private List<Secenek> _secenekler = [];
    private bool _yukleniyor = true;
    private ApiHatasi? _hata;

    private bool GecerliMi => _secenekler.Any(s => s.Secili) && _secenekler.Where(s => s.Secili).All(s => s.Miktar > 0);

    protected override async Task OnInitializedAsync()
    {
        var sonuc = await Api.GetAsync<List<AktarilacakSiparisSatiri>>(
            $"api/fatura/teklif-siparis/aktarim?cariId={CariId}&tur={SiparisTuru}&yalnizcaUrun={(YalnizcaUrun ? "true" : "false")}");
        _hata = sonuc.Hata;
        _secenekler = sonuc.BasariliMi
            ? sonuc.Deger.Where(s => !Mevcutlar.Contains(s.SiparisSatiriId))
                .Select(s => new Secenek(s) { Miktar = s.KalanMiktar, Secili = s.SiparisId == SeciliSiparis }).ToList()
            : [];
        _yukleniyor = false;
    }

    private void GrupSec(Guid siparisId, bool secili) => _secenekler.Where(s => s.Satir.SiparisId == siparisId).ToList().ForEach(s => s.Secili = secili);

    private void Aktar() =>
        MudDialog.Close(DialogResult.Ok(_secenekler.Where(s => s.Secili).Select(s => new SiparisAktarimi(s.Satir, s.Miktar)).ToList()));

    private sealed class Secenek(AktarilacakSiparisSatiri satir)
    {
        public AktarilacakSiparisSatiri Satir { get; } = satir;
        public bool Secili { get; set; }
        public decimal Miktar { get; set; }
    }
}
