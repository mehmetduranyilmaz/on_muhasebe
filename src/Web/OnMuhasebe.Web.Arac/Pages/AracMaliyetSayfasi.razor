@page "/arac/maliyet"
@inject ApiIstemcisi Api
@inject IsyeriYoneticisi Isyerleri

<SayfaBasligi Baslik="Araç Maliyet Raporu" GeriAdres="arac" Ikon="@Icons.Material.Filled.Assessment"
              AltBaslik="Takip kayıtlarından hesaplanır, muhasebe rakamı değildir. Km ve tüketim için yakıt kayıtlarında km girilmelidir." />

<HataGosterimi Hata="_hata" />

<FiltreCubugu>
    <MudItem xs="6" md="2">
        <MudDatePicker Variant="Variant.Outlined" @bind-Date="_baslangic" Label="Başlangıç" Margin="Margin.Dense" DateFormat="dd.MM.yyyy" />
    </MudItem>
    <MudItem xs="6" md="2">
        <MudDatePicker Variant="Variant.Outlined" @bind-Date="_bitis" Label="Bitiş" Margin="Margin.Dense" DateFormat="dd.MM.yyyy" />
    </MudItem>
    <MudItem xs="12" md="2" Class="d-flex align-center">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="YukleAsync">Göster</MudButton>
    </MudItem>
</FiltreCubugu>

@if (_satirlar is { Count: 0 })
{
    <BosDurum Ikon="@Icons.Material.Outlined.DirectionsCar" Baslik="Araç yok" />
}
else if (_satirlar is { } s)
{
    <div class="panel-kart kart belirme mt-3 mb-4" style="overflow-x:auto">
        <MudSimpleTable Dense="true" Elevation="0" Class="arac-maliyeti">
            <thead>
                <tr>
                    <th>Plaka</th><th class="sayi">Yakıt</th><th class="sayi">Masraf</th><th class="sayi">Sigorta / muayene</th><th class="sayi">MTV</th><th class="sayi">Hasar (net)</th>
                    <th class="sayi">Toplam</th><th class="sayi">Km</th><th class="sayi">TL/km</th><th class="sayi">L/100 km</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in s)
                {
                    <tr>
                        <td><MudLink Href="@($"arac/{m.AracId}")"><b>@m.Plaka</b></MudLink></td>
                        <td class="sayi">@Bicim.Tutar(m.Yakit)</td>
                        <td class="sayi">@Bicim.Tutar(m.Masraf)</td>
                        <td class="sayi">@Bicim.Tutar(m.Sigorta)</td>
                        <td class="sayi">@Bicim.Tutar(m.Mtv)</td>
                        <td class="sayi">@Bicim.Tutar(m.HasarNet)</td>
                        <td class="sayi"><b>@Bicim.Tutar(m.Toplam)</b></td>
                        <td class="sayi">@(m.Km?.ToString("N0", Bicim.Kultur))</td>
                        <td class="sayi">@(m.KmBasinaMaliyet is { } k ? Bicim.Tutar(k) : "")</td>
                        <td class="sayi">@(m.Tuketim is { } t ? Bicim.Tutar(t) : "")</td>
                    </tr>
                }
                <tr>
                    <td><b>Toplam</b></td>
                    <td class="sayi"><b>@Bicim.Tutar(s.Sum(m => m.Yakit))</b></td>
                    <td class="sayi"><b>@Bicim.Tutar(s.Sum(m => m.Masraf))</b></td>
                    <td class="sayi"><b>@Bicim.Tutar(s.Sum(m => m.Sigorta))</b></td>
                    <td class="sayi"><b>@Bicim.Tutar(s.Sum(m => m.Mtv))</b></td>
                    <td class="sayi"><b>@Bicim.Tutar(s.Sum(m => m.HasarNet))</b></td>
                    <td class="sayi"><b>@Bicim.Tutar(s.Sum(m => m.Toplam))</b></td>
                    <td colspan="3"></td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </div>
}

@code {
    private DateTime? _baslangic = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime? _bitis = DateTime.Today;
    private List<AracMaliyeti>? _satirlar;
    private ApiHatasi? _hata;

    protected override async Task OnInitializedAsync()
    {
        await Isyerleri.YukleAsync();
        await YukleAsync();
    }

    private async Task YukleAsync()
    {
        if (_baslangic is null || _bitis is null)
        {
            _hata = new ApiHatasi("Başlangıç ve bitiş tarihi seçin.", null, new Dictionary<string, string[]>());
            return;
        }

        var sonuc = await Api.GetAsync<List<AracMaliyeti>>($"api/arac/raporlar/maliyet?baslangic={Bicim.Iso(Bicim.Gun(_baslangic)!.Value)}&bitis={Bicim.Iso(Bicim.Gun(_bitis)!.Value)}{Isyerleri.Sorgu()}");
        _hata = sonuc.Hata;
        _satirlar = sonuc.BasariliMi ? sonuc.Deger : null;
    }
}
