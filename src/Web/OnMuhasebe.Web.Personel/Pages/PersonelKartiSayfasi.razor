@page "/personel/{Id:guid}"
@inject ApiIstemcisi Api
@inject NavigationManager Navigasyon
@inject IDialogService DialogService
@inject OnayServisi Onay
@inject OturumYoneticisi Oturum
@inject ISnackbar Snackbar

<SayfaBasligi Baslik="@(_p is { } b ? $"{b.Ad} {b.Soyad}" : "Personel")" GeriAdres="personel" Ikon="@Icons.Material.Filled.Badge" AltBaslik="@(_p is { } a ? $"{a.Kod}{(a.IstenCikis is { } c ? $" · Ayrıldı: {Bicim.Tarih(c)}" : "")}" : null)">
    <Islemler>
        @if (_p is { } d)
        {
            <DosyalarDugmesi Tur="@DosyaKayitTurleri.Personel" KayitId="d.Id" />
            @if (Oturum.YazabilirMi(PersonelYetkileri.Avans, YetkiIslemleri.Ekle) && d.IstenCikis is null)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Savings" OnClick="AvansAsync">Avans Ver</MudButton>
            }
            @if (Oturum.YazabilirMi(PersonelYetkileri.Kart, YetkiIslemleri.Duzenle))
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="DuzenleAsync">Düzenle</MudButton>
                @if (d.IstenCikis is null)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.ExitToApp" OnClick="CikisAsync">İşten Çıkış</MudButton>
                }
            }
            @if (Oturum.YazabilirMi(PersonelYetkileri.Kart, YetkiIslemleri.Sil))
            {
                <MudButton Color="Color.Error" OnClick="SilAsync">Sil</MudButton>
            }
        }
    </Islemler>
</SayfaBasligi>

<HataGosterimi Hata="_hata" />

@if (_p is { } p)
{
    @if (_uyari is not null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3 belirme cikis-uyarisi">@_uyari</MudAlert>
    }

    <div class="panel-kart kart belirme mb-4">
        <MudSimpleTable Dense="true" Elevation="0" Class="personel-bilgi">
            <tbody>
                <tr><th>Görev</th><td>@p.Gorev</td><th>Departman</th><td>@p.Departman</td></tr>
                <tr><th>İşe giriş</th><td>@Bicim.Tarih(p.IseGiris)</td><th>Telefon</th><td>@p.Telefon</td></tr>
                <tr><th>TC kimlik</th><td>@p.TcKimlik</td><th>IBAN</th><td>@p.Iban</td></tr>
                @if (p.NetMaas is { } maas)
                {
                    <tr><th>Net maaş</th><td>@Bicim.Tutar(maas) TL</td><th>E-posta</th><td>@p.Eposta</td></tr>
                }
            </tbody>
        </MudSimpleTable>
    </div>

    @if (_hesap is { } h)
    {
        <div class="panel-kart kart belirme mb-4" style="overflow-x:auto">
            <div class="panel-baslik"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" /> Personel hesabı
                <b class="ml-2 @(h.Bakiye < 0 ? "bakiye-borclu" : "")">@Bicim.Tutar(h.Bakiye) TL @(h.Bakiye < 0 ? "(personel borçlu)" : h.Bakiye > 0 ? "(firma borçlu)" : "")</b>
            </div>
            <MudSimpleTable Dense="true" Elevation="0" Class="personel-hesabi">
                <thead><tr><th>Tarih</th><th>İşlem</th><th>Açıklama</th><th class="sayi">Alacak</th><th class="sayi">Borç</th><th class="sayi">Bakiye</th></tr></thead>
                <tbody>
                    @foreach (var s in h.Satirlar)
                    {
                        <tr><td>@Bicim.Tarih(s.Tarih)</td><td>@s.Islem</td><td>@s.Aciklama</td><td class="sayi">@Bicim.Tutar(s.Alacak)</td><td class="sayi">@Bicim.Tutar(s.Borc)</td><td class="sayi">@Bicim.Tutar(s.Bakiye)</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>

        @if (_odemeler.Count > 0)
        {
            <div class="panel-kart kart belirme mb-4" style="overflow-x:auto">
                <div class="panel-baslik"><MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" /> Ödemeler</div>
                <MudSimpleTable Dense="true" Elevation="0" Class="personel-odemeleri">
                    <thead><tr><th>Tarih</th><th>Tür</th><th class="sayi">Tutar</th><th>Kasa/banka</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var o in _odemeler)
                        {
                            <tr>
                                <td>@Bicim.Tarih(o.Tarih)</td>
                                <td>@PersonelMetinleri.Odeme(o.Tur)</td>
                                <td class="sayi">@Bicim.Tutar(o.Tutar)</td>
                                <td>@(o.KasaYazildiMi ? "Yazıldı" : "Yalnız kayıt")</td>
                                <td style="text-align:right">
                                    @if (o.Tur != PersonelOdemeTuru.Avans && Oturum.YazabilirMi(PersonelYetkileri.Maas, YetkiIslemleri.Iptal))
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => OdemeIptalAsync(o))">İptal</MudButton>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    }

    @if (_avanslar.Count > 0)
    {
        <div class="panel-kart kart belirme mb-4" style="overflow-x:auto">
            <div class="panel-baslik"><MudIcon Icon="@Icons.Material.Filled.Savings" Size="Size.Small" /> Avanslar</div>
            <MudSimpleTable Dense="true" Elevation="0" Class="personel-avanslari">
                <thead><tr><th>Tarih</th><th class="sayi">Tutar</th><th>Taksit</th><th class="sayi">Kalan</th><th>Açıklama</th><th></th></tr></thead>
                <tbody>
                    @foreach (var a in _avanslar)
                    {
                        <tr>
                            <td>@Bicim.Tarih(a.Tarih)</td>
                            <td class="sayi">@Bicim.Tutar(a.Tutar)</td>
                            <td>@a.TaksitSayisi</td>
                            <td class="sayi">@(a.IptalMi ? "İptal" : Bicim.Tutar(a.Kalan))</td>
                            <td>@a.Aciklama</td>
                            <td style="text-align:right">
                                @if (!a.IptalMi && a.Kalan == a.Tutar && Oturum.YazabilirMi(PersonelYetkileri.Avans, YetkiIslemleri.Iptal))
                                {
                                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => AvansIptalAsync(a))">İptal</MudButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private PersonelDetayi? _p;
    private PersonelHesabi? _hesap;
    private List<AvansCevabi> _avanslar = [];
    private List<PersonelOdemeCevabi> _odemeler = [];
    private string? _uyari;
    private ApiHatasi? _hata;

    protected override Task OnParametersSetAsync() => YukleAsync();

    private async Task YukleAsync()
    {
        var p = await Api.GetAsync<PersonelDetayi>($"api/personel/kartlar/{Id}");
        _hata = p.Hata;
        _p = p.BasariliMi ? p.Deger : null;
        if (_p is null)
        {
            return;
        }

        if (Oturum.YetkiVarMi(PersonelYetkileri.Maas, YetkiIslemleri.Goruntule))
        {
            _hesap = await Api.GetAsync<PersonelHesabi>($"api/personel/kartlar/{Id}/hesap") is { BasariliMi: true } h ? h.Deger : null;
            _odemeler = await Api.GetAsync<List<PersonelOdemeCevabi>>($"api/personel/kartlar/{Id}/odemeler") is { BasariliMi: true } o ? o.Deger : [];
        }

        if (Oturum.YetkiVarMi(PersonelYetkileri.Avans, YetkiIslemleri.Goruntule))
        {
            _avanslar = await Api.GetAsync<List<AvansCevabi>>($"api/personel/avanslar?personelId={Id}") is { BasariliMi: true } a ? a.Deger : [];
        }
    }

    private async Task DuzenleAsync()
    {
        var parametreler = new DialogParameters<PersonelDialog> { { d => d.Personel, _p } };
        var dialog = await DialogService.ShowAsync<PersonelDialog>("Personeli Düzenle", parametreler, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        if (await dialog.Result is { Canceled: false })
        {
            await YukleAsync();
        }
    }

    private async Task AvansAsync()
    {
        var parametreler = new DialogParameters<OdemeDialog> { { d => d.Baslik, "Avans" }, { d => d.TaksitIste, true }, { d => d.TutarIste, true } };
        var dialog = await DialogService.ShowAsync<OdemeDialog>("Avans Ver", parametreler, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        if (await dialog.Result is { Canceled: false, Data: OdemeDialog.Secim s })
        {
            var sonuc = await Api.PostAsync<AvansCevabi>("api/personel/avanslar", new AvansKaydetIstegi(Id, s.Tarih, s.Tutar ?? 0, s.Taksit, s.HesapId, s.Aciklama));
            _hata = sonuc.Hata;
            if (sonuc.BasariliMi)
            {
                Snackbar.Add("Avans verildi.", Severity.Success);
                await YukleAsync();
            }
        }
    }

    private async Task AvansIptalAsync(AvansCevabi a)
    {
        if (await Onay.SorAsync("Avans iptal edilsin mi?", "Kasa/banka çıkışı da geri alınır.", "İptal Et", tehlikeli: true))
        {
            var sonuc = await Api.PostAsync($"api/personel/avanslar/{a.Id}/iptal", new { });
            _hata = sonuc.Hata;
            await YukleAsync();
        }
    }

    private async Task OdemeIptalAsync(PersonelOdemeCevabi o)
    {
        if (await Onay.SorAsync("Ödeme iptal edilsin mi?", "Kasa/banka hareketi ters kayıtla geri alınır.", "İptal Et", tehlikeli: true))
        {
            var sonuc = await Api.PostAsync($"api/personel/odemeler/{o.Id}/iptal", new { });
            _hata = sonuc.Hata;
            await YukleAsync();
        }
    }

    private async Task CikisAsync()
    {
        var parametreler = new DialogParameters<OdemeDialog> { { d => d.Baslik, "İşten çıkış" }, { d => d.HesapIste, false } };
        var dialog = await DialogService.ShowAsync<OdemeDialog>("İşten Çıkış", parametreler, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        if (await dialog.Result is { Canceled: false, Data: OdemeDialog.Secim s })
        {
            var sonuc = await Api.PostAsync<IstenCikisSonucu>($"api/personel/kartlar/{Id}/isten-cikis", new IstenCikisIstegi(s.Tarih));
            _hata = sonuc.Hata;
            if (sonuc.BasariliMi)
            {
                var r = sonuc.Deger;
                var parcalar = new List<string>();
                if (r.AcikZimmet > 0)
                {
                    parcalar.Add($"üzerinde {r.AcikZimmet} zimmet var");
                }

                if (r.KalanBakiye != 0)
                {
                    parcalar.Add($"hesap bakiyesi {Bicim.Tutar(r.KalanBakiye)} TL");
                }

                _uyari = parcalar.Count > 0 ? $"Çıkış kaydedildi, ancak {string.Join(" ve ", parcalar)}." : null;
                await YukleAsync();
            }
        }
    }

    private async Task SilAsync()
    {
        if (await Onay.SorAsync("Personel silinsin mi?", "Hareketi olan personel silinemez; işten çıkış girin.", "Sil", tehlikeli: true))
        {
            var sonuc = await Api.DeleteAsync($"api/personel/kartlar/{Id}");
            _hata = sonuc.Hata;
            if (sonuc.BasariliMi)
            {
                Navigasyon.NavigateTo("personel");
            }
        }
    }
}
