@page "/giris"
@layout BosLayout
@attribute [AllowAnonymous]
@inject OturumYoneticisi Oturum
@inject NavigationManager Navigasyon

<PageTitle>Giriş - Ön Muhasebe</PageTitle>

<h2>Tekrar hoş geldiniz</h2>
<div class="alt">Devam etmek için hesabınıza giriş yapın.</div>

<form @onsubmit="GirisYapAsync" @onsubmit:preventDefault="true">
    <HataGosterimi Hata="_hata" />
    <MudTextField T="string" @bind-Value="_eposta" Label="E-posta" InputType="InputType.Email" Variant="Variant.Outlined"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Email" Class="mb-4" autocomplete="username" />
    <MudTextField T="string" @bind-Value="_sifre" Label="Şifre" InputType="@(_sifreGorunur ? InputType.Text : InputType.Password)"
                  Variant="Variant.Outlined" Adornment="Adornment.End"
                  AdornmentIcon="@(_sifreGorunur ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                  OnAdornmentClick="() => _sifreGorunur = !_sifreGorunur" AdornmentAriaLabel="Şifreyi göster" autocomplete="current-password" />
    <div class="d-flex justify-end mt-1">
        <MudLink Href="sifremi-unuttum" Typo="Typo.body2">Şifremi unuttum</MudLink>
    </div>
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
               Disabled="_islemde" Class="mt-6">
        @if (_islemde)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="width:18px;height:18px;" />
        }
        Giriş Yap
    </MudButton>
</form>

<MudDivider Class="my-6" />
<MudButton Href="kayit" Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" StartIcon="@Icons.Material.Filled.RocketLaunch">
    Hesabınız yok mu? 14 gün ücretsiz deneyin
</MudButton>

@code {
    [SupplyParameterFromQuery(Name = "donus")]
    public string? Donus { get; set; }

    private string _eposta = "";
    private string _sifre = "";
    private bool _sifreGorunur;
    private bool _islemde;
    private ApiHatasi? _hata;

    protected override void OnInitialized()
    {
        if (Oturum.Bilgi is not null)
        {
            Navigasyon.NavigateTo(GuvenliDonusAdresi());
        }
    }

    private async Task GirisYapAsync()
    {
        if (string.IsNullOrWhiteSpace(_eposta) || string.IsNullOrEmpty(_sifre))
        {
            _hata = new ApiHatasi("E-posta ve şifre girin.", null, new Dictionary<string, string[]>());
            return;
        }

        _islemde = true;
        _hata = null;
        var sonuc = await Oturum.GirisAsync(new GirisIstegi(_eposta, _sifre));
        _islemde = false;

        if (sonuc.BasariliMi)
        {
            Navigasyon.NavigateTo(GuvenliDonusAdresi());
        }
        else
        {
            _hata = sonuc.Hata;
        }
    }

    // Açık yönlendirme (open redirect) saldırısına karşı yalnızca uygulama içi göreli adreslere dönülür.
    private string GuvenliDonusAdresi() =>
        Donus is { Length: > 1 } d && d.StartsWith('/') && !d.StartsWith("//") && !d.StartsWith("/\\") ? d.TrimStart('/') : "";
}
