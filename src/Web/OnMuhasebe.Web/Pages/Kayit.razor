@page "/kayit"
@layout BosLayout
@attribute [AllowAnonymous]
@inject OturumYoneticisi Oturum
@inject NavigationManager Navigasyon
@inject ISnackbar Snackbar

<PageTitle>Kayıt Ol - Ön Muhasebe</PageTitle>

@if (_gonderildi)
{
    <h2>E-postanızı doğrulayın</h2>
    <div class="belirme">
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.MarkEmailRead">
            <b>@_eposta</b> adresine bir doğrulama bağlantısı gönderdik. Hesabınız bağlantıya tıkladığınızda etkinleşir.
        </MudAlert>
        <div class="alt">E-posta gelmediyse istenmeyen (spam) klasörüne bakın. Bağlantı 24 saat geçerlidir.</div>
        <IslemDugmesi Islem="TekrarAsync" Variant="Variant.Outlined" FullWidth="true" StartIcon="@Icons.Material.Filled.Send">Bağlantıyı yeniden gönder</IslemDugmesi>
    </div>
}
else
{
<h2>Ücretsiz deneyin</h2>
<div class="alt">14 gün boyunca tüm modüller açık. Kredi kartı gerekmez.</div>

<HataGosterimi Hata="_hata" />

<MudForm @ref="_form">
    <MudTextField @bind-Value="_firmaUnvani" Label="Firma ünvanı" Variant="Variant.Outlined" Class="mb-3" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Business"
                  Required="true" RequiredError="Firma ünvanı gerekli." MaxLength="250" />
    <MudTextField @bind-Value="_vergiNo" Label="Vergi / T.C. kimlik no (isteğe bağlı)" Variant="Variant.Outlined" Class="mb-3" Margin="Margin.Dense"
                  Validation="@(new Func<string?, string?>(VergiNoKontrol))" MaxLength="11" />
    <MudGrid Spacing="2" Class="mb-1">
        <MudItem xs="6">
            <MudTextField @bind-Value="_ad" Label="Ad" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Ad gerekli." />
        </MudItem>
        <MudItem xs="6">
            <MudTextField @bind-Value="_soyad" Label="Soyad" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Soyad gerekli." />
        </MudItem>
    </MudGrid>
    <MudTextField @bind-Value="_eposta" Label="E-posta" InputType="InputType.Email" Variant="Variant.Outlined" Class="mb-3" Margin="Margin.Dense"
                  Required="true" RequiredError="E-posta gerekli." autocomplete="username" />
    <MudTextField @bind-Value="_sifre" Label="Şifre" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" Margin="Margin.Dense"
                  Required="true" RequiredError="Şifre gerekli." Validation="@(new Func<string?, IEnumerable<string>>(SifreKurallari.Kontrol))"
                  HelperText="En az 8 karakter, harf ve rakam içermeli." autocomplete="new-password" />
    <MudTextField @bind-Value="_sifreTekrar" Label="Şifre (tekrar)" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Required="true" RequiredError="Şifreyi tekrar girin." Validation="@(new Func<string?, string?>(SifreTekrarKontrol))"
                  autocomplete="new-password" />
</MudForm>

<IslemDugmesi Islem="KayitOlAsync" FullWidth="true" Size="Size.Large" Class="mt-5">Hesap Oluştur</IslemDugmesi>
}
<MudButton Href="giris" Variant="Variant.Text" FullWidth="true" Class="mt-2">Zaten hesabınız var mı? Giriş yapın</MudButton>

@code {
    private MudForm _form = null!;
    private string _firmaUnvani = "";
    private string? _vergiNo;
    private string _ad = "";
    private string _soyad = "";
    private string _eposta = "";
    private string _sifre = "";
    private string _sifreTekrar = "";
    private bool _gonderildi;
    private ApiHatasi? _hata;

    private async Task KayitOlAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _hata = null;
        var sonuc = await Oturum.KayitAsync(new KayitIstegi(_firmaUnvani, _vergiNo, _ad, _soyad, _eposta, _sifre));
        _gonderildi = sonuc.BasariliMi;
        _hata = sonuc.Hata;
    }

    private async Task TekrarAsync()
    {
        var sonuc = await Oturum.DogrulamaTekrarAsync(_eposta.Trim());
        Snackbar.Add(sonuc.BasariliMi ? "Bağlantı yeniden gönderildi (iki dakikada en fazla bir kez)." : sonuc.Hata.Baslik,
            sonuc.BasariliMi ? Severity.Info : Severity.Warning);
    }

    private static string? VergiNoKontrol(string? deger) =>
        string.IsNullOrWhiteSpace(deger) || (deger.Length is 10 or 11 && deger.All(char.IsAsciiDigit))
            ? null
            : "Vergi numarası 10, T.C. kimlik numarası 11 haneli olmalıdır.";

    private string? SifreTekrarKontrol(string? deger) => deger == _sifre ? null : "Şifreler eşleşmiyor.";
}
