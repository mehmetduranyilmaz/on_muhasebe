@* Kullanıcı daveti: kişiye e-postayla bağlantı gider; kişi kabul edince firmaya katılır. *@
@inject ApiIstemcisi Api
@inject OturumYoneticisi Oturum

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-3">
            Kişiye davet e-postası gönderilir. Hesabı yoksa bağlantıyla kendi şifresini belirler, varsa mevcut hesabıyla katılır.
            Bağlantı 7 gün geçerlidir.
        </MudAlert>
        <HataGosterimi Hata="_hata" />
        <MudForm @ref="_form">
            <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_eposta" Label="E-posta" InputType="InputType.Email"
                          Required="true" RequiredError="E-posta gerekli." />
            <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_rolId" Label="Rol" Class="mt-3"
                       Required="true" RequiredError="Rol seçin.">
                @foreach (var rol in _roller)
                {
                    <MudSelectItem Value="@rol.Id">@rol.Ad</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Vazgeç</MudButton>
        <IslemDugmesi Islem="GonderAsync" StartIcon="@Icons.Material.Filled.Send">Davet gönder</IslemDugmesi>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private string _eposta = "";
    private List<RolCevabi> _roller = [];
    private Guid _rolId;
    private ApiHatasi? _hata;

    protected override async Task OnInitializedAsync()
    {
        var sonuc = await Api.GetAsync<List<RolCevabi>>("api/yonetim/roller");
        _hata = sonuc.Hata;
        // Yönetici rolünü yalnızca yönetici verebilir.
        _roller = (sonuc.Deger ?? []).Where(r => !r.TamYetkiliMi || Oturum.Bilgi?.Yetki?.TamYetkiliMi == true).ToList();
        _rolId = (_roller.Find(r => r.Ad == "Kullanıcı") ?? _roller.Find(r => !r.TamYetkiliMi))?.Id ?? Guid.Empty;
    }

    private async Task GonderAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        var sonuc = await Api.PostAsync<DavetOzeti>("api/yonetim/kullanicilar", new KullaniciDavetIstegi(_eposta.Trim(), _rolId));
        _hata = sonuc.Hata;
        if (sonuc.BasariliMi)
        {
            MudDialog.Close(DialogResult.Ok(sonuc.Deger));
        }
    }
}
