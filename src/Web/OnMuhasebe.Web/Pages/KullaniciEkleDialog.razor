@inject ApiIstemcisi Api

<MudDialog>
    <DialogContent>
        <HataGosterimi Hata="_hata" />
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_ad" Label="Ad" Required="true" RequiredError="Ad gerekli." />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_soyad" Label="Soyad" Required="true" RequiredError="Soyad gerekli." />
                </MudItem>
            </MudGrid>
            <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_eposta" Label="E-posta" InputType="InputType.Email" Class="mt-3"
                          Required="true" RequiredError="E-posta gerekli." />
            <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_sifre" Label="Şifre" InputType="InputType.Password" Class="mt-3"
                          Validation="@(new Func<string?, IEnumerable<string>>(SifreKurallari.Kontrol))"
                          HelperText="Kullanıcı sistemde zaten kayıtlıysa boş bırakın; mevcut hesabı firmanıza bağlanır." />
            <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_rol" Label="Rol" Class="mt-3">
                <MudSelectItem Value="@Roller.Kullanici">Kullanıcı</MudSelectItem>
                <MudSelectItem Value="@Roller.Yonetici">Yönetici</MudSelectItem>
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Vazgeç</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_islemde" OnClick="KaydetAsync">Ekle</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private string _ad = "";
    private string _soyad = "";
    private string _eposta = "";
    private string? _sifre;
    private string _rol = Roller.Kullanici;
    private bool _islemde;
    private ApiHatasi? _hata;

    private async Task KaydetAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _islemde = true;
        var istek = new KullaniciEkleIstegi(_ad, _soyad, _eposta, string.IsNullOrEmpty(_sifre) ? null : _sifre, _rol);
        var sonuc = await Api.PostAsync<FirmaKullanicisiCevabi>("api/yonetim/kullanicilar", istek);
        _islemde = false;

        if (sonuc.BasariliMi)
        {
            MudDialog.Close(DialogResult.Ok(sonuc.Deger));
        }
        else
        {
            _hata = sonuc.Hata;
        }
    }
}
