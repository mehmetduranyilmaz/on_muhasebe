@* Kullanıcı daveti: kişiye e-postayla bağlantı gider; kişi kabul edince firmaya katılır. *@
@inject ApiIstemcisi Api

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-3">
            Kişiye davet e-postası gönderilir. Hesabı yoksa bağlantıyla kendi şifresini belirler, varsa mevcut hesabıyla katılır.
            Bağlantı 7 gün geçerlidir.
        </MudAlert>
        <HataGosterimi Hata="_hata" />
        <MudForm @ref="_form">
            <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_eposta" Label="E-posta" InputType="InputType.Email"
                          Required="true" RequiredError="E-posta gerekli." />
            <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_rol" Label="Rol" Class="mt-3">
                <MudSelectItem Value="@Roller.Kullanici">Kullanıcı</MudSelectItem>
                <MudSelectItem Value="@Roller.Yonetici">Yönetici</MudSelectItem>
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Vazgeç</MudButton>
        <IslemDugmesi Islem="GonderAsync" StartIcon="@Icons.Material.Filled.Send">Davet gönder</IslemDugmesi>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private string _eposta = "";
    private string _rol = Roller.Kullanici;
    private ApiHatasi? _hata;

    private async Task GonderAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        var sonuc = await Api.PostAsync<DavetOzeti>("api/yonetim/kullanicilar", new KullaniciDavetIstegi(_eposta.Trim(), _rol));
        _hata = sonuc.Hata;
        if (sonuc.BasariliMi)
        {
            MudDialog.Close(DialogResult.Ok(sonuc.Deger));
        }
    }
}
