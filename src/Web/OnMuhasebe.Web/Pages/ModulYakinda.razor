@* Modül ekranları kendi adımlarında eklendikçe ilgili rota buradan kaldırılır. *@
@page "/stok"
@page "/fatura"
@page "/kasabanka"
@inject NavigationManager Navigasyon

<PageTitle>@_ad - Ön Muhasebe</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@_ad</MudText>
<MudAlert Severity="Severity.Info">Bu modülün ekranları hazırlanıyor.</MudAlert>

@code {
    private string _ad = "";

    protected override void OnParametersSet() =>
        _ad = ModulMenusu.Ad(Navigasyon.ToBaseRelativePath(Navigasyon.Uri).Split('?')[0]);
}
