@page "/ayarlar"
@attribute [Authorize]
@inject OturumYoneticisi Oturum
@inject ModulYukleyici Yukleyici

<SayfaBasligi Baslik="Ayarlar" AltBaslik="@(Oturum.Bilgi?.AktifFirma?.Unvan is { } unvan ? $"{unvan} için firma ayarları" : null)"
             Ikon="@Icons.Material.Filled.Tune" />

<FirmaBilgileriPaneli Sira="0" />
<IsyerleriPaneli Sira="1" />

@if (_yukleniyor)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="260px" Animation="Animation.Wave" Class="rounded-lg" />
}
else
{
    @for (var i = 0; i < _paneller.Count; i++)
    {
        <DynamicComponent Type="_paneller[i]" Parameters="@(new Dictionary<string, object> { ["Sira"] = i + 1 })" />
    }
    <ZorunluAlanlarPaneli Sira="_paneller.Count + 1" />
    <DonemKilidiPaneli Sira="_paneller.Count + 2" />
    <BildirimAyarPaneli Sira="_paneller.Count + 3" />
}

@code {
    private readonly List<Type> _paneller = [];
    private bool _yukleniyor = true;

    // Her lisanslı modül kendi ayar panelini kendi lazy paketinde sunar.
    protected override async Task OnInitializedAsync()
    {
        foreach (var modul in ModulMenusu.Tumu.Where(m => Oturum.ModulAcikMi(m.Kod)))
        {
            if (await Yukleyici.AyarPaneliAsync(modul.Kod) is { } panel)
            {
                _paneller.Add(panel);
            }
        }

        _yukleniyor = false;
    }
}
