@page "/ayarlar"
@page "/ayarlar/{Bolum}"
@attribute [Authorize]
@inject OturumYoneticisi Oturum
@inject ModulYukleyici Yukleyici
@inject NavigationManager Navigasyon

@* Ayarlar merkezi: her bölüm kendi adresinde (/ayarlar/firma, /ayarlar/kagit-cikti...). Adressiz açılırsa erişilebilen ilk bölüme gider. *@
<PageTitle>Ayarlar - Ön Muhasebe</PageTitle>

@if (_bolum is { } b)
{
    <AyarlarCercevesi SeciliYol="@b.Yol">
        <SayfaBasligi Baslik="Ayarlar" AltBaslik="@($"{b.Grup} · {b.Ad}")" Ikon="@Icons.Material.Filled.Tune" />
        @switch (b.Yol)
        {
            case "firma":
                <FirmaBilgileriPaneli />
                break;
            case "isyerleri":
                <IsyerleriPaneli />
                break;
            case "zorunlu-alanlar":
                <ZorunluAlanlarPaneli />
                break;
            case "donem-kilidi":
                <DonemKilidiPaneli />
                break;
            case "bildirimler":
                <BildirimAyarPaneli />
                break;
            default:
                @if (_panel is { } panel)
                {
                    <DynamicComponent @key="b.Yol" Type="panel" Parameters="@(b.PanelParametreleri?.ToDictionary() ?? [])" />
                }
                else
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="260px" Animation="Animation.Wave" Class="rounded-lg" />
                }
                break;
        }
    </AyarlarCercevesi>
}
else if (_erisimYok)
{
    <BosDurum Ikon="@Icons.Material.Outlined.Lock" Baslik="Bu ayara erişiminiz yok" Aciklama="Firma yöneticinizden yetki isteyebilirsiniz." />
}

@code {
    [Parameter] public string? Bolum { get; set; }

    private AyarBolumu? _bolum;
    private Type? _panel;
    private bool _erisimYok;

    protected override async Task OnParametersSetAsync()
    {
        (_bolum, _panel, _erisimYok) = (null, null, false);
        if (Bolum is null)
        {
            // Sayfası bu merkezde olan ilk bölüme; yoksa (yalnız kullanıcı yönetimi yetkisi gibi) ayrı sayfasına.
            var erisilebilir = AyarBolumleri.Erisilebilir(Oturum).ToList();
            if ((erisilebilir.FirstOrDefault(x => x.Href is null) ?? erisilebilir.FirstOrDefault()) is { } ilk)
            {
                Navigasyon.NavigateTo(ilk.Adres, replace: true);
            }
            else
            {
                _erisimYok = true;
            }

            return;
        }

        if (AyarBolumleri.Bul(Bolum) is not { Href: null } bolum || !bolum.ErisilebilirMi(Oturum))
        {
            _erisimYok = true;
            return;
        }

        _bolum = bolum;
        if (bolum is { ModulKodu: { } modul, PanelTipi: { } tip })
        {
            _panel = await Yukleyici.PanelAsync(modul, tip);
        }
    }
}
