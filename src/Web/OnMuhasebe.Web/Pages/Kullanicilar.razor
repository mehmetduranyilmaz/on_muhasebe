@page "/kullanicilar"
@attribute [Authorize(Roles = Roller.Yonetici)]
@inject ApiIstemcisi Api
@inject IDialogService DialogService
@inject OnayServisi Onay
@inject ISnackbar Snackbar
@inject OturumYoneticisi Oturum
@inject TimeProvider Zaman

<SayfaBasligi Baslik="Kullanıcılar" AltBaslik="Firmanıza erişebilen kişiler ve rolleri" Ikon="@Icons.Material.Filled.ManageAccounts">
    <Islemler>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="EkleAsync">Kullanıcı Davet Et</MudButton>
    </Islemler>
</SayfaBasligi>

<HataGosterimi Hata="_hata" />

<VeriTablosu T="FirmaKullanicisiCevabi" Kayitlar="_kullanicilar" BosBaslik="Kayıtlı kullanıcı yok" BosIkon="@Icons.Material.Outlined.Group">
    <Basliklar>
        <MudTh>Ad Soyad</MudTh>
        <MudTh>E-posta</MudTh>
        <MudTh>Rol</MudTh>
        <MudTh>Durum</MudTh>
        <MudTh></MudTh>
    </Basliklar>
    <Satir>
        <MudTd DataLabel="Ad Soyad">
            <div class="d-flex align-center gap-2">
                <MudAvatar Size="Size.Small" Class="kullanici-avatar">@($"{context.Ad.FirstOrDefault()}{context.Soyad.FirstOrDefault()}")</MudAvatar>
                @context.Ad @context.Soyad
            </div>
        </MudTd>
        <MudTd DataLabel="E-posta">@context.Eposta</MudTd>
        <MudTd DataLabel="Rol">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.TamYetkiliMi ? Color.Secondary : Color.Default)">
                @context.RolAdi
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Durum">
            <MudChip T="string" Size="Size.Small" Color="@(context.AktifMi ? Color.Success : Color.Default)">@(context.AktifMi ? "Aktif" : "Pasif")</MudChip>
        </MudTd>
        <MudTd Style="text-align: right;">
            @if (context.AktifMi && context.KullaniciId != Oturum.Bilgi?.Id)
            {
                <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => PasiflestirAsync(context)">Pasifleştir</MudButton>
            }
        </MudTd>
    </Satir>
</VeriTablosu>

@if (_davetler is { Count: > 0 })
{
    <div class="mt-6 mb-2 d-flex align-center gap-2">
        <MudIcon Icon="@Icons.Material.Filled.MarkEmailUnread" Color="Color.Primary" />
        <MudText Typo="Typo.h6">Bekleyen davetler</MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@_davetler.Count</MudChip>
    </div>
    <VeriTablosu T="DavetOzeti" Kayitlar="_davetler" BosBaslik="Bekleyen davet yok" BosIkon="@Icons.Material.Outlined.MarkEmailRead">
        <Basliklar>
            <MudTh>E-posta</MudTh>
            <MudTh>Rol</MudTh>
            <MudTh>Gönderildi</MudTh>
            <MudTh>Geçerlilik</MudTh>
            <MudTh></MudTh>
        </Basliklar>
        <Satir>
            <MudTd DataLabel="E-posta">@context.Eposta</MudTd>
            <MudTd DataLabel="Rol">@context.RolAdi</MudTd>
            <MudTd DataLabel="Gönderildi">@context.SonGonderimTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Geçerlilik">
                @if (context.BitisTarihi < Zaman.GetUtcNow().UtcDateTime)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Süresi doldu</MudChip>
                }
                else
                {
                    @context.BitisTarihi.ToLocalTime().ToString("dd.MM.yyyy")
                }
            </MudTd>
            <MudTd Style="text-align: right; white-space: nowrap;">
                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Send" OnClick="() => YenidenGonderAsync(context)">Yeniden gönder</MudButton>
                <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => IptalEtAsync(context)">İptal</MudButton>
            </MudTd>
        </Satir>
    </VeriTablosu>
}

@code {
    private List<FirmaKullanicisiCevabi>? _kullanicilar;
    private List<DavetOzeti>? _davetler;
    private ApiHatasi? _hata;

    protected override Task OnInitializedAsync() => YukleAsync();

    private async Task YukleAsync()
    {
        var sonuc = await Api.GetAsync<List<FirmaKullanicisiCevabi>>("api/yonetim/kullanicilar");
        _hata = sonuc.Hata;
        _kullanicilar = sonuc.BasariliMi ? sonuc.Deger : [];
        var davetler = await Api.GetAsync<List<DavetOzeti>>("api/yonetim/kullanicilar/davetler");
        _davetler = davetler.BasariliMi ? davetler.Deger : [];
    }

    private async Task EkleAsync()
    {
        var dialog = await DialogService.ShowAsync<KullaniciEkleDialog>("Kullanıcı Davet Et");
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Davet gönderildi. Kişi kabul edince kullanıcılar listesinde görünecek.", Severity.Success);
            await YukleAsync();
        }
    }

    private async Task YenidenGonderAsync(DavetOzeti davet)
    {
        var sonuc = await Api.PostAsync<DavetOzeti>($"api/yonetim/kullanicilar/davetler/{davet.Id}/yeniden-gonder", new { });
        Snackbar.Add(sonuc.BasariliMi ? $"Davet {davet.Eposta} adresine yeniden gönderildi." : sonuc.Hata.Baslik, sonuc.BasariliMi ? Severity.Success : Severity.Warning);
        await YukleAsync();
    }

    private async Task IptalEtAsync(DavetOzeti davet)
    {
        if (!await Onay.SorAsync("Daveti iptal et", $"{davet.Eposta} adresine gönderilen davet bağlantısı geçersiz olacak. Devam edilsin mi?", "İptal et", tehlikeli: true))
        {
            return;
        }

        var sonuc = await Api.DeleteAsync($"api/yonetim/kullanicilar/davetler/{davet.Id}");
        Snackbar.Add(sonuc.BasariliMi ? "Davet iptal edildi." : sonuc.Hata.Baslik, sonuc.BasariliMi ? Severity.Success : Severity.Error);
        await YukleAsync();
    }

    private async Task PasiflestirAsync(FirmaKullanicisiCevabi kullanici)
    {
        if (!await Onay.SorAsync("Kullanıcıyı pasifleştir",
                $"{kullanici.Ad} {kullanici.Soyad} bu firmaya artık erişemeyecek. Devam edilsin mi?", "Pasifleştir", tehlikeli: true))
        {
            return;
        }

        var sonuc = await Api.PostAsync($"api/yonetim/kullanicilar/{kullanici.KullaniciId}/pasiflestir");
        if (sonuc.BasariliMi)
        {
            Snackbar.Add("Kullanıcı pasifleştirildi.", Severity.Success);
            await YukleAsync();
        }
        else
        {
            Snackbar.Add(sonuc.Hata.Baslik, Severity.Error);
        }
    }
}
