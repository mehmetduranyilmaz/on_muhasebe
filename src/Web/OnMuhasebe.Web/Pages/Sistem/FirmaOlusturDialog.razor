@inject ApiIstemcisi Api
@inject TimeProvider Zaman

<MudDialog>
    <DialogContent>
        <HataGosterimi Hata="_hata" />
        <MudForm @ref="_form">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Firma</MudText>
            <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_unvan" Label="Ünvan" Required="true" RequiredError="Ünvan gerekli." />
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_vergiNo" Label="Vergi / T.C. kimlik no" MaxLength="11" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_vergiDairesi" Label="Vergi dairesi" />
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Firma yöneticisi</MudText>
            <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_yoneticiEposta" Label="E-posta" InputType="InputType.Email"
                          Required="true" RequiredError="E-posta gerekli."
                          HelperText="Bu adrese davet gider; kişi bağlantıyla hesabını kurar ya da mevcut hesabıyla katılır." />

            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Lisans</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_paketKodu" Label="Paket" Required="true" RequiredError="Paket seçin.">
                        @foreach (var paket in Paketler)
                        {
                            <MudSelectItem Value="@paket.Kod">@paket.Ad</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Date="_bitis" Label="Bitiş tarihi (dahil)" Required="true" RequiredError="Tarih seçin." />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Vazgeç</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_islemde" OnClick="KaydetAsync">Firma Aç</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public IReadOnlyList<PaketOzeti> Paketler { get; set; } = [];

    private MudForm _form = null!;
    private string _unvan = "";
    private string? _vergiNo;
    private string? _vergiDairesi;
    private string _yoneticiEposta = "";
    private string? _paketKodu = PaketKodlari.Basic;
    private DateTime? _bitis;
    private bool _islemde;
    private ApiHatasi? _hata;

    protected override void OnInitialized() => _bitis = Zaman.GetLocalNow().Date.AddYears(1);

    private async Task KaydetAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _islemde = true;
        var istek = new FirmaOlusturIstegi(
            _unvan, _vergiNo, _vergiDairesi, _yoneticiEposta, _paketKodu!, DateOnly.FromDateTime(_bitis!.Value));
        var sonuc = await Api.PostAsync<FirmaOlusturCevabi>("api/yonetim/sistem/firmalar", istek);
        _islemde = false;

        if (sonuc.BasariliMi)
        {
            MudDialog.Close(DialogResult.Ok(sonuc.Deger));
        }
        else
        {
            _hata = sonuc.Hata;
        }
    }
}
