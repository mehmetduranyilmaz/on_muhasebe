@page "/sistem/firmalar"
@attribute [Authorize(Roles = Roller.SistemYoneticisi)]
@inject ApiIstemcisi Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TimeProvider Zaman

<SayfaBasligi Baslik="Firmalar ve Lisanslar" AltBaslik="Müşteri firmalar, paketleri ve lisans süreleri" Ikon="@Icons.Material.Filled.AdminPanelSettings">
    <Islemler>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBusiness" OnClick="FirmaAcAsync">Firma Aç</MudButton>
    </Islemler>
</SayfaBasligi>

<HataGosterimi Hata="_hata" />

<FiltreCubugu>
    <MudItem xs="12" md="6">
        <MudTextField Variant="Variant.Outlined" T="string" Value="_arama" ValueChanged="AraAsync" Placeholder="Ünvan veya vergi no ile ara"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" DebounceInterval="400"
                      Margin="Margin.Dense" Clearable="true" />
    </MudItem>
</FiltreCubugu>

<VeriTablosu T="SistemFirmaOzeti" Kayitlar="_sonuc?.Kayitlar" Yukleniyor="_yukleniyor" Sayfa="_sayfa" ToplamSayfa="_sonuc?.ToplamSayfa ?? 0"
             SayfaDegisti="SayfaDegistirAsync" BosBaslik="Firma bulunamadı" BosIkon="@Icons.Material.Outlined.Business">
    <Basliklar>
        <MudTh>Ünvan</MudTh>
        <MudTh>Vergi No</MudTh>
        <MudTh>Paket</MudTh>
        <MudTh>Ek Modüller</MudTh>
        <MudTh>Lisans Bitişi</MudTh>
        <MudTh>Kullanıcı</MudTh>
        <MudTh></MudTh>
    </Basliklar>
    <Satir>
        <MudTd DataLabel="Ünvan"><b>@context.Unvan</b></MudTd>
        <MudTd DataLabel="Vergi No">@context.VergiNo</MudTd>
        <MudTd DataLabel="Paket">
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">@(PaketAdi(context.PaketKodu) ?? "—")</MudChip>
        </MudTd>
        <MudTd DataLabel="Ek Modüller">@string.Join(", ", context.EkModuller.Select(ModulMenusu.Ad))</MudTd>
        <MudTd DataLabel="Lisans Bitişi">
            @if (context.LisansBitisTarihi is { } bitis)
            {
                var dolduMu = bitis <= Zaman.GetUtcNow().UtcDateTime;
                <MudChip T="string" Size="Size.Small" Color="@(dolduMu ? Color.Error : Color.Success)" Variant="Variant.Text">
                    @bitis.AddDays(-1).ToString("d")@(dolduMu ? " · doldu" : "")
                </MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Kullanıcı">@context.KullaniciSayisi</MudTd>
        <MudTd Style="text-align: right;">
            <MudButton Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.WorkspacePremium" OnClick="() => LisansAtaAsync(context)">Lisans</MudButton>
        </MudTd>
    </Satir>
</VeriTablosu>

@code {
    private SayfaliSonuc<SistemFirmaOzeti>? _sonuc;
    private List<PaketOzeti> _paketler = [];
    private string? _arama;
    private int _sayfa = 1;
    private bool _yukleniyor;
    private ApiHatasi? _hata;

    protected override async Task OnInitializedAsync()
    {
        var paketler = await Api.GetAsync<List<PaketOzeti>>("api/yonetim/sistem/paketler");
        _paketler = paketler.BasariliMi ? paketler.Deger : [];
        await YukleAsync();
    }

    private async Task YukleAsync()
    {
        _yukleniyor = true;
        var sonuc = await Api.GetAsync<SayfaliSonuc<SistemFirmaOzeti>>(
            $"api/yonetim/sistem/firmalar?sayfa={_sayfa}&arama={Uri.EscapeDataString(_arama ?? "")}");
        _hata = sonuc.Hata;
        _sonuc = sonuc.BasariliMi ? sonuc.Deger : new SayfaliSonuc<SistemFirmaOzeti>([], 1, 20, 0);
        _yukleniyor = false;
    }

    private async Task AraAsync(string? arama)
    {
        _arama = arama;
        _sayfa = 1;
        await YukleAsync();
    }

    private async Task SayfaDegistirAsync(int sayfa)
    {
        _sayfa = sayfa;
        await YukleAsync();
    }

    private async Task FirmaAcAsync()
    {
        var parametreler = new DialogParameters<FirmaOlusturDialog> { { d => d.Paketler, _paketler } };
        var dialog = await DialogService.ShowAsync<FirmaOlusturDialog>("Firma Aç", parametreler);
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Firma açıldı; yöneticiye davet e-postası gönderildi.", Severity.Success);
            await YukleAsync();
        }
    }

    private async Task LisansAtaAsync(SistemFirmaOzeti firma)
    {
        var parametreler = new DialogParameters<LisansAtaDialog>
        {
            { d => d.Firma, firma },
            { d => d.Paketler, _paketler }
        };
        var dialog = await DialogService.ShowAsync<LisansAtaDialog>($"Lisans: {firma.Unvan}", parametreler);
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Lisans güncellendi.", Severity.Success);
            await YukleAsync();
        }
    }

    private string? PaketAdi(string? kod) => kod is null ? null : _paketler.Find(p => p.Kod == kod)?.Ad ?? kod;
}
