@implements IDisposable
@inject OturumYoneticisi Oturum
@inject NavigationManager Navigasyon
@inject ISnackbar Snackbar

@if (Oturum.Bilgi is { } bilgi)
{
    var aktifUnvan = bilgi.AktifFirma?.Unvan ?? (bilgi.SistemYoneticisiMi ? "Sistem Yönetimi" : "Firma seçilmedi");

    @if (bilgi.Firmalar.Count > 1)
    {
        <MudMenu Label="@aktifUnvan" EndIcon="@Icons.Material.Filled.ArrowDropDown" Color="Color.Inherit"
                 Variant="Variant.Text" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="mr-2">
            @foreach (var firma in bilgi.Firmalar)
            {
                <MudMenuItem OnClick="() => DegistirAsync(firma)" Disabled="@(firma.Id == bilgi.AktifFirma?.Id)">
                    @firma.Unvan
                </MudMenuItem>
            }
        </MudMenu>
    }
    else
    {
        <MudText Typo="Typo.body1" Class="mr-2">@aktifUnvan</MudText>
    }
}

@code {
    protected override void OnInitialized() => Oturum.Degisti += YenidenCiz;

    public void Dispose() => Oturum.Degisti -= YenidenCiz;

    private void YenidenCiz() => InvokeAsync(StateHasChanged);

    private async Task DegistirAsync(FirmaOzeti firma)
    {
        var sonuc = await Oturum.FirmaDegistirAsync(firma.Id);
        if (sonuc.BasariliMi)
        {
            Snackbar.Add($"{firma.Unvan} firmasına geçildi.", Severity.Success);
            Navigasyon.NavigateTo("");
        }
        else
        {
            Snackbar.Add(sonuc.Hata.Baslik, Severity.Error);
        }
    }
}
