@implements IDisposable
@inject ModulYukleyici Yukleyici
@inject TemaYoneticisi Tema

<MudThemeProvider @ref="_temaSaglayici" Theme="UygulamaTemasi.Tema" IsDarkMode="Tema.KoyuMu" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" BackdropClick="false" />
<MudSnackbarProvider />

<Router AppAssembly="typeof(App).Assembly" AdditionalAssemblies="Yukleyici.Derlemeler" OnNavigateAsync="NavigasyonAsync"
        NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <MudAlert Severity="Severity.Warning" Class="ma-4">Bu sayfaya erişim yetkiniz yok.</MudAlert>
                }
                else
                {
                    <GiriseYonlendir />
                }
            </NotAuthorized>
            <Authorizing>
                <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <Navigating>
        <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
    </Navigating>
</Router>

@code {
    private MudThemeProvider _temaSaglayici = null!;

    protected override void OnInitialized() => Tema.Degisti += YenidenCiz;

    protected override async Task OnAfterRenderAsync(bool ilkCizim)
    {
        if (!ilkCizim)
        {
            return;
        }

        await Tema.YukleAsync();
        Tema.SistemAyariniBildir(await _temaSaglayici.GetSystemDarkModeAsync());
        await _temaSaglayici.WatchSystemDarkModeAsync(koyuMu =>
        {
            Tema.SistemAyariniBildir(koyuMu);
            return Task.CompletedTask;
        });
    }

    // Modül ekranlarının kodu yalnızca lisans varsa ve modüle ilk girildiğinde indirilir.
    private async Task NavigasyonAsync(Microsoft.AspNetCore.Components.Routing.NavigationContext context)
    {
        if (ModulPaketleri.AdrestekiModul(context.Path) is { } modul)
        {
            await Yukleyici.YukleAsync(modul.Kod);
        }
    }

    private void YenidenCiz() => InvokeAsync(StateHasChanged);

    public void Dispose() => Tema.Degisti -= YenidenCiz;
}
