<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- Uygulama kültürü tr-TR; tarayıcı dili farklı olsa da Türkçe biçimlendirme verisi yüklensin. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <!-- Modül ekranları lazy yüklenir (bkz. ModulPaketleri). -->
  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="OnMuhasebe.Web.Cari.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OnMuhasebe.Modules.Cari.Contracts.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OnMuhasebe.Modules.Doviz.Contracts.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OnMuhasebe.Web.Stok.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OnMuhasebe.Modules.Stok.Contracts.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OnMuhasebe.Web.Fatura.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OnMuhasebe.Modules.Fatura.Contracts.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OnMuhasebe.Web.KasaBanka.wasm" />
    <BlazorWebAssemblyLazyLoad Include="OnMuhasebe.Modules.KasaBanka.Contracts.wasm" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnMuhasebe.Web.Cari\OnMuhasebe.Web.Cari.csproj" />
    <ProjectReference Include="..\OnMuhasebe.Web.Stok\OnMuhasebe.Web.Stok.csproj" />
    <ProjectReference Include="..\OnMuhasebe.Web.Fatura\OnMuhasebe.Web.Fatura.csproj" />
    <ProjectReference Include="..\OnMuhasebe.Web.KasaBanka\OnMuhasebe.Web.KasaBanka.csproj" />
    <ProjectReference Include="..\OnMuhasebe.Web.Ortak\OnMuhasebe.Web.Ortak.csproj" />
  </ItemGroup>

</Project>
