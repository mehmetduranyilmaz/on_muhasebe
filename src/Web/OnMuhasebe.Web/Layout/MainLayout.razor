@inherits LayoutComponentBase
@implements IDisposable
@inject OturumYoneticisi Oturum
@inject TemaYoneticisi Tema
@inject NavigationManager Navigasyon

<MudLayout Class="@(Tema.KoyuMu ? "koyu-tema" : null)">
    <MudAppBar Elevation="0" Class="ust-cubuk">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="() => _menuAcik = !_menuAcik" aria-label="Menü" />
        <a href="" class="ml-2 d-flex"><Logo Boyut="32" Class="ust-logo" /></a>
        <MudSpacer />
        <FirmaSecici />
        <BildirimZili />
        <MudTooltip Text="@(Tema.KoyuMu ? "Açık temaya geç" : "Koyu temaya geç")">
            <MudIconButton Icon="@(Tema.KoyuMu ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="Tema.SiradakineGecAsync" aria-label="Temayı değiştir" />
        </MudTooltip>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-1">
            @* MudBlazor 9: özel tetikleyicide tıklamayı bileşen kendisi bağlar. *@
            <ActivatorContent Context="menu">
                <button type="button" class="avatar-dugmesi" @onclick="menu.ToggleAsync" aria-label="Kullanıcı menüsü">
                    <MudAvatar Size="Size.Small" Class="kullanici-avatar">@BasHarfler</MudAvatar>
                </button>
            </ActivatorContent>
            <ChildContent>
                <div class="px-4 pt-3 pb-2">
                    <MudText Typo="Typo.subtitle2">@Oturum.Bilgi?.Ad @Oturum.Bilgi?.Soyad</MudText>
                    <MudText Typo="Typo.caption">@Oturum.Bilgi?.Eposta</MudText>
                </div>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="CikisAsync">Çıkış</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_menuAcik" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Responsive" Width="260px">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <LisansBandi />
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            <div class="sayfa-gecis" @key="_sayfaAnahtari">
                @Body
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _menuAcik = true;
    private string _sayfaAnahtari = "";

    private string BasHarfler => Oturum.Bilgi is { } b ? $"{b.Ad.FirstOrDefault()}{b.Soyad.FirstOrDefault()}".ToUpperInvariant() : "?";

    protected override void OnInitialized()
    {
        Oturum.Degisti += OturumDegisti;
        Tema.Degisti += YenidenCiz;
        Navigasyon.LocationChanged += AdresDegisti;
        AnahtariGuncelle();
    }

    public void Dispose()
    {
        Oturum.Degisti -= OturumDegisti;
        Tema.Degisti -= YenidenCiz;
        Navigasyon.LocationChanged -= AdresDegisti;
    }

    // Sayfa değişince ya da firma değişince içerik yeniden oluşturulur: geçiş animasyonu oynar, veriler yeni firmadan yüklenir.
    private void AnahtariGuncelle() =>
        _sayfaAnahtari = $"{Navigasyon.ToBaseRelativePath(Navigasyon.Uri).Split('?')[0]}|{Oturum.Bilgi?.AktifFirma?.Id}";

    private void AdresDegisti(object? sender, LocationChangedEventArgs e)
    {
        AnahtariGuncelle();
        YenidenCiz();
    }

    private void OturumDegisti()
    {
        AnahtariGuncelle();
        YenidenCiz();
    }

    private void YenidenCiz() => InvokeAsync(StateHasChanged);

    private async Task CikisAsync()
    {
        await Oturum.CikisAsync();
        Navigasyon.NavigateTo("giris");
    }
}
