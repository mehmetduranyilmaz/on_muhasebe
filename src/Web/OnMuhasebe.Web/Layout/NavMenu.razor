@implements IDisposable
@inject OturumYoneticisi Oturum

<MudNavMenu Class="pt-2">
    @if (_acikModuller.Count > 0)
    {
        <div class="menu-bolum-basligi">Modüller</div>
        @foreach (var modul in _acikModuller)
        {
            <MudNavLink Href="@modul.Yol" Icon="@modul.Ikon">@modul.Ad</MudNavLink>
        }
    }

    @if (_yonetim.Count > 0 || Oturum.Bilgi?.SistemYoneticisiMi == true)
    {
        <div class="menu-bolum-basligi">Yönetim</div>
    }
    @foreach (var (yol, ikon, ad) in _yonetim)
    {
        <MudNavLink Href="@yol" Icon="@ikon">@ad</MudNavLink>
    }
    <AuthorizeView Roles="@Roller.SistemYoneticisi">
        <MudNavLink Href="sistem/firmalar" Icon="@Icons.Material.Filled.AdminPanelSettings">Firmalar ve Lisanslar</MudNavLink>
        <MudNavLink Href="sistem/odeme-bildirimleri" Icon="@Icons.Material.Filled.AccountBalanceWallet">Ödeme Bildirimleri</MudNavLink>
        <MudNavLink Href="sistem/paketler" Icon="@Icons.Material.Filled.Sell">Paketler ve Ödeme</MudNavLink>
        <MudNavLink Href="sistem/eposta" Icon="@Icons.Material.Filled.MarkEmailRead">E-posta ve Bildirimler</MudNavLink>
    </AuthorizeView>
</MudNavMenu>

@code {
    private static readonly (string Yol, string Ikon, string Ad)[] _yonetimOgeleri =
    [
        ("kullanicilar", Icons.Material.Filled.ManageAccounts, "Kullanıcılar"),
        ("roller", Icons.Material.Filled.AdminPanelSettings, "Roller ve Yetkiler"),
        ("abonelik", Icons.Material.Filled.WorkspacePremium, "Abonelik"),
        ("ayarlar", Icons.Material.Filled.Tune, "Ayarlar")
    ];

    private List<ModulMenuOgesi> _acikModuller = [];
    private List<(string Yol, string Ikon, string Ad)> _yonetim = [];

    protected override void OnInitialized()
    {
        Oturum.Degisti += OturumDegisti;
        MenuyuGuncelle();
    }

    public void Dispose() => Oturum.Degisti -= OturumDegisti;

    // Lisansı olan ve ekranı görme yetkisi bulunan bölümler listelenir.
    private void MenuyuGuncelle()
    {
        _acikModuller = ModulMenusu.MenuOgeleri.Where(m => Oturum.ModulAcikMi(m.Kod) && Oturum.YetkiVarMi(m.GorunumYetkisi)).ToList();
        _yonetim = _yonetimOgeleri.Where(o => SayfaYetkileri.Gereken(o.Yol) is { } y && Oturum.YetkiVarMi(y)).ToList();
    }

    private void OturumDegisti()
    {
        MenuyuGuncelle();
        InvokeAsync(StateHasChanged);
    }
}
