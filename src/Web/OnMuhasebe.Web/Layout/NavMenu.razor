@implements IDisposable
@inject OturumYoneticisi Oturum

<MudNavMenu Class="pt-2">
    @if (_acikModuller.Count > 0)
    {
        <div class="menu-bolum-basligi">Modüller</div>
        @foreach (var modul in _acikModuller)
        {
            <MudNavLink Href="@modul.Yol" Icon="@modul.Ikon">@modul.Ad</MudNavLink>
        }
    }

    <AuthorizeView Roles="@($"{Roller.Yonetici},{Roller.SistemYoneticisi}")">
        <div class="menu-bolum-basligi">Yönetim</div>
    </AuthorizeView>
    <AuthorizeView Roles="@Roller.Yonetici">
        <MudNavLink Href="kullanicilar" Icon="@Icons.Material.Filled.ManageAccounts">Kullanıcılar</MudNavLink>
        <MudNavLink Href="abonelik" Icon="@Icons.Material.Filled.WorkspacePremium">Abonelik</MudNavLink>
        <MudNavLink Href="ayarlar" Icon="@Icons.Material.Filled.Tune">Ayarlar</MudNavLink>
    </AuthorizeView>
    <AuthorizeView Roles="@Roller.SistemYoneticisi">
        <MudNavLink Href="sistem/firmalar" Icon="@Icons.Material.Filled.AdminPanelSettings">Firmalar ve Lisanslar</MudNavLink>
        <MudNavLink Href="sistem/odeme-bildirimleri" Icon="@Icons.Material.Filled.AccountBalanceWallet">Ödeme Bildirimleri</MudNavLink>
        <MudNavLink Href="sistem/paketler" Icon="@Icons.Material.Filled.Sell">Paketler ve Ödeme</MudNavLink>
    </AuthorizeView>
</MudNavMenu>

@code {
    private List<ModulMenuOgesi> _acikModuller = [];

    protected override void OnInitialized()
    {
        Oturum.Degisti += OturumDegisti;
        ModulleriGuncelle();
    }

    public void Dispose() => Oturum.Degisti -= OturumDegisti;

    private void ModulleriGuncelle() => _acikModuller = ModulMenusu.MenuOgeleri.Where(m => Oturum.ModulAcikMi(m.Kod)).ToList();

    private void OturumDegisti()
    {
        ModulleriGuncelle();
        InvokeAsync(StateHasChanged);
    }
}
