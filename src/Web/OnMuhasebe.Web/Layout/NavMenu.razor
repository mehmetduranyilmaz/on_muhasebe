@implements IDisposable
@inject OturumYoneticisi Oturum

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Ana Sayfa</MudNavLink>

    @foreach (var modul in ModulMenusu.Tumu.Where(m => Oturum.ModulAcikMi(m.Kod)))
    {
        <MudNavLink Href="@modul.Yol" Icon="@modul.Ikon">@modul.Ad</MudNavLink>
    }

    <AuthorizeView Roles="@Roller.Yonetici">
        <MudDivider Class="my-2" />
        <MudNavLink Href="kullanicilar" Icon="@Icons.Material.Filled.ManageAccounts">Kullanıcılar</MudNavLink>
    </AuthorizeView>

    <AuthorizeView Roles="@Roller.SistemYoneticisi">
        <MudDivider Class="my-2" />
        <MudNavLink Href="sistem/firmalar" Icon="@Icons.Material.Filled.AdminPanelSettings">Firmalar ve Lisanslar</MudNavLink>
    </AuthorizeView>
</MudNavMenu>

@code {
    protected override void OnInitialized() => Oturum.Degisti += YenidenCiz;

    public void Dispose() => Oturum.Degisti -= YenidenCiz;

    private void YenidenCiz() => InvokeAsync(StateHasChanged);
}
