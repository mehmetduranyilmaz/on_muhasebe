@page "/kasabanka/yeni"
@page "/kasabanka/{Id:guid}/duzenle"
@inject ApiIstemcisi Api
@inject NavigationManager Navigasyon
@inject ISnackbar Snackbar

<SayfaBasligi Baslik="@(Id is null ? "Yeni Hesap" : "Hesabı Düzenle")" GeriAdres="@(Id is null ? "kasabanka" : $"kasabanka/{Id}")"
             Ikon="@KasaMetinleri.HesapIkonu(_tur)" AltBaslik="@KasaMetinleri.HesapTuruAciklamasi(_tur)" />

<HataGosterimi Hata="_hata" />

@if (_yukleniyor)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="360px" Animation="Animation.Wave" Class="rounded-lg" />
}
else
{
    <MudForm @ref="_form">
        <FormBolumu Baslik="Hesap türü" Aciklama="@(_hareketVarMi ? "Hareketi olan hesabın türü ve dövizi değiştirilemez" : "Kasa, banka, kredi kartı veya POS")"
                    Ikon="@Icons.Material.Filled.Category" Sira="0">
            <MudItem xs="12">
                <div class="tur-sekmeleri mb-0">
                    @foreach (var tur in KasaMetinleri.HesapTurleri)
                    {
                        <button type="button" class="tur-sekmesi @(_tur == tur ? "secili" : "")" style="--vurgu:@KasaMetinleri.HesapRenkleri(tur).Son"
                                disabled="@_hareketVarMi" @onclick="() => _tur = tur">
                            <MudIcon Icon="@KasaMetinleri.HesapIkonu(tur)" Size="Size.Small" /> @KasaMetinleri.HesapTuru(tur)
                        </button>
                    }
                </div>
            </MudItem>
        </FormBolumu>

        <FormBolumu Baslik="Hesap bilgileri" Aciklama="Ad, kod ve para birimi" Ikon="@Icons.Material.Filled.Badge" Sira="1">
            <MudItem xs="12" sm="4" md="2">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_kod" Label="Kod" MaxLength="20" HelperText="Boşsa otomatik" />
            </MudItem>
            <MudItem xs="12" sm="8" md="6">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_ad" Label="Hesap adı" Required="true" RequiredError="Ad gerekli."
                              MaxLength="150" Placeholder="@Ornek" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_paraBirimi" Label="Para birimi" Disabled="_hareketVarMi">
                    @foreach (var pb in ParaBirimleri.Tumu)
                    {
                        <MudSelectItem Value="pb.Kod">@pb.Kod - @pb.Ad</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </FormBolumu>

        @if (_tur != HesapTuru.Kasa)
        {
            <FormBolumu Baslik="@(_tur == HesapTuru.Banka ? "Banka bilgileri" : _tur == HesapTuru.KrediKarti ? "Kart bilgileri" : "POS bilgileri")"
                        Ikon="@Icons.Material.Filled.AccountBalance" Sira="2">
                <MudItem xs="12" sm="6" md="4">
                    <BankaSecici Value="@_bankaAdi" ValueChanged="BankaSecildi" />
                </MudItem>

                @if (_tur == HesapTuru.Banka)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect T="BankaHesapTuru" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_bankaHesapTuru" Label="Hesap türü">
                            <MudSelectItem Value="BankaHesapTuru.Vadesiz">Vadesiz</MudSelectItem>
                            <MudSelectItem Value="BankaHesapTuru.Vadeli">Vadeli</MudSelectItem>
                            <MudSelectItem Value="BankaHesapTuru.Kmh">Kredili mevduat (KMH)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <SubeSecici BankaAdi="@_bankaAdi" Value="_seciliSube" ValueChanged="SubeSecildi" />
                    </MudItem>
                    @if (_seciliSube is { } sb && (sb.PortfoyYoneticisi is not null || sb.Telefon is not null || sb.Faks is not null))
                    {
                        <MudItem xs="12">
                            <div class="ozet-alt d-flex flex-wrap gap-3" style="opacity:.75">
                                @if (sb.PortfoyYoneticisi is { } py)
                                {
                                    <span><MudIcon Icon="@Icons.Material.Filled.SupportAgent" Size="Size.Small" /> @py</span>
                                }
                                @if (sb.Telefon is { } tel)
                                {
                                    <span><MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" /> @tel</span>
                                }
                                @if (sb.Faks is { } faks)
                                {
                                    <span><MudIcon Icon="@Icons.Material.Filled.Print" Size="Size.Small" /> @faks</span>
                                }
                            </div>
                        </MudItem>
                    }
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_hesapNo" Label="Hesap no" MaxLength="50" />
                    </MudItem>
                    <MudItem xs="12" md="8">
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_iban" Label="IBAN" MaxLength="40" Placeholder="TR00 0000 0000 0000 0000 0000 00"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Tag" Immediate="true"
                                      Error="@(!string.IsNullOrWhiteSpace(_iban) && !IbanBicimiDogruMu(_iban))" ErrorText="TR ile başlayan 26 karakter olmalı" />
                    </MudItem>
                }
                else if (_tur == HesapTuru.KrediKarti)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_hesapNo" Label="Kart no (son 4 hane yeterli)" MaxLength="50" />
                    </MudItem>
                    <MudItem xs="6" sm="3" md="2">
                        <MudNumericField T="int?" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_hesapKesimGunu" Label="Hesap kesim günü" Min="1" Max="31" HideSpinButtons="true" HelperText="Ayın günü" />
                    </MudItem>
                    <MudItem xs="6" sm="3" md="2">
                        <MudNumericField T="int?" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_sonOdemeGunu" Label="Son ödeme günü" Min="1" Max="31" HideSpinButtons="true" HelperText="Ayın günü" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudNumericField T="decimal?" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_limit" Label="Kart limiti" Format="N2" Min="0" HideSpinButtons="true" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_hesapNo" Label="Üye işyeri no" MaxLength="50" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect T="PosCalismaSekli" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_posCalismaSekli" Label="Çalışma şekli">
                            <MudSelectItem Value="PosCalismaSekli.Komisyonlu">Komisyonlu</MudSelectItem>
                            <MudSelectItem Value="PosCalismaSekli.Blokeli">Blokeli</MudSelectItem>
                            <MudSelectItem Value="PosCalismaSekli.Karma">Karma (bloke + komisyon)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    @if (_posCalismaSekli is PosCalismaSekli.Komisyonlu or PosCalismaSekli.Karma)
                    {
                        <MudItem xs="6" sm="4" md="3">
                            <MudNumericField T="decimal?" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_posKomisyonOrani" Label="Komisyon oranı %" Format="N2" Min="0" Max="100" HideSpinButtons="true" />
                        </MudItem>
                    }
                    <MudItem xs="6" sm="4" md="3">
                        <MudNumericField T="int?" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_posGunSayisi" Min="0" Max="365" HideSpinButtons="true"
                                         Label="@(_posCalismaSekli == PosCalismaSekli.Komisyonlu ? "Valör (gün)" : "Bloke gün")" />
                    </MudItem>
                    <MudItem xs="6" sm="4" md="3">
                        <MudSelect T="BlokeGunTipi" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_posGunTipi" Label="Gün tipi">
                            <MudSelectItem Value="BlokeGunTipi.TakvimGunu">Takvim günü</MudSelectItem>
                            <MudSelectItem Value="BlokeGunTipi.IsGunu">İş günü</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect T="Guid?" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_posAktarilacakHesapId" Label="Çözüldüğünde aktarılacak hesap" Clearable="true"
                                   Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AccountBalance">
                            @foreach (var h in _bankaHesaplari)
                            {
                                <MudSelectItem T="Guid?" Value="h.Id">@h.Ad · @h.ParaBirimi</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="4" md="3">
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_posTerminalNo" Label="Terminal no" MaxLength="30" />
                    </MudItem>
                    <MudItem xs="6" sm="4" md="3">
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_posBatchNo" Label="Batch no (gün sonu)" MaxLength="30" />
                    </MudItem>
                }
            </FormBolumu>
        }

        <FormBolumu Baslik="Not" Ikon="@Icons.Material.Filled.Notes" Sira="3">
            <MudItem xs="12">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_aciklama" Label="Açıklama" MaxLength="500" />
            </MudItem>
        </FormBolumu>
    </MudForm>

    <div class="d-flex gap-2 justify-end">
        <MudButton Href="@(Id is null ? "kasabanka" : $"kasabanka/{Id}")">Vazgeç</MudButton>
        <IslemDugmesi Islem="KaydetAsync" StartIcon="@Icons.Material.Filled.Save">Kaydet</IslemDugmesi>
    </div>
}

@code {
    private readonly IslemAnahtari _anahtar = new();

    [Parameter] public Guid? Id { get; set; }

    private MudForm _form = null!;
    private HesapTuru _tur = HesapTuru.Kasa;
    private string? _kod;
    private string _ad = "";
    private string _paraBirimi = ParaBirimleri.Tl;
    private string? _bankaAdi;
    private BankaHesapTuru _bankaHesapTuru = BankaHesapTuru.Vadesiz;
    private string? _sube;
    private Guid? _subeId;
    private SubeOzeti? _seciliSube;
    private string? _hesapNo;
    private string? _iban;
    private decimal? _limit;
    private int? _hesapKesimGunu;
    private int? _sonOdemeGunu;
    private PosCalismaSekli _posCalismaSekli = PosCalismaSekli.Komisyonlu;
    private decimal? _posKomisyonOrani;
    private int? _posGunSayisi;
    private BlokeGunTipi _posGunTipi = BlokeGunTipi.IsGunu;
    private Guid? _posAktarilacakHesapId;
    private string? _posTerminalNo;
    private string? _posBatchNo;
    private List<HesapOzeti> _bankaHesaplari = [];
    private string? _aciklama;
    private uint _surum;
    private bool _hareketVarMi;
    private bool _yukleniyor = true;
    private ApiHatasi? _hata;

    // Banka değişince o bankaya ait olmayan şube seçimi geçersiz kalır; temizlenir.
    private void BankaSecildi(string? banka)
    {
        if (banka != _bankaAdi)
        {
            (_seciliSube, _subeId, _sube) = (null, null, null);
        }

        _bankaAdi = banka;
    }

    private void SubeSecildi(SubeOzeti? sube)
    {
        _seciliSube = sube;
        _subeId = sube?.Id;
        _sube = sube?.Ad;
    }

    private string Ornek => _tur switch
    {
        HesapTuru.Kasa => "Merkez Kasa",
        HesapTuru.Banka => "Ziraat Bankası TL",
        HesapTuru.KrediKarti => "Şirket Kartı",
        _ => "Mağaza POS"
    };

    protected override async Task OnInitializedAsync()
    {
        // POS'ta "çözüldüğünde aktarılacak hesap" için banka hesapları.
        var hesaplar = await Api.GetAsync<List<HesapOzeti>>("api/kasabanka/hesaplar?tur=Banka&aktif=true");
        _bankaHesaplari = hesaplar.BasariliMi ? hesaplar.Deger : [];

        if (Id is { } id)
        {
            var sonuc = await Api.GetAsync<HesapDetayi>($"api/kasabanka/hesaplar/{id}");
            if (!sonuc.BasariliMi)
            {
                _hata = sonuc.Hata;
                _yukleniyor = false;
                return;
            }

            var h = sonuc.Deger;
            (_tur, _kod, _ad, _paraBirimi, _bankaAdi, _sube) = (h.Tur, h.Kod, h.Ad, h.ParaBirimi, h.BankaAdi, h.Sube);
            (_hesapNo, _iban, _limit, _aciklama, _surum, _hareketVarMi) = (h.HesapNo, h.Iban, h.Limit, h.Aciklama, h.Surum, h.HareketVarMi);
            _bankaHesapTuru = h.BankaHesapTuru ?? BankaHesapTuru.Vadesiz;
            (_subeId, _hesapKesimGunu, _sonOdemeGunu) = (h.SubeId, h.HesapKesimGunu, h.SonOdemeGunu);
            _posCalismaSekli = h.PosCalismaSekli ?? PosCalismaSekli.Komisyonlu;
            (_posKomisyonOrani, _posGunSayisi) = (h.PosKomisyonOrani, h.PosGunSayisi);
            _posGunTipi = h.PosGunTipi ?? BlokeGunTipi.IsGunu;
            (_posAktarilacakHesapId, _posTerminalNo, _posBatchNo) = (h.PosAktarilacakHesapId, h.PosTerminalNo, h.PosBatchNo);
            _bankaHesaplari = _bankaHesaplari.Where(x => x.Id != id).ToList();

            if (h.SubeId is { } subeId && await Api.GetAsync<SubeDetayi>($"api/kasabanka/subeler/{subeId}") is { BasariliMi: true } sd)
            {
                _seciliSube = new SubeOzeti(sd.Deger.Id, sd.Deger.BankaAdi, sd.Deger.Ad, sd.Deger.PortfoyYoneticisi, sd.Deger.Telefon, sd.Deger.Faks);
            }
        }

        _yukleniyor = false;
    }

    // Kontrol hanesi sunucuda doğrulanır; burada yalnızca biçim uyarısı verilir.
    private static bool IbanBicimiDogruMu(string iban)
    {
        var deger = new string(iban.Where(c => !char.IsWhiteSpace(c)).ToArray()).ToUpperInvariant();
        return !deger.StartsWith("TR", StringComparison.Ordinal) ? deger.Length is >= 15 and <= 34 : deger.Length == 26;
    }

    private async Task KaydetAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        var istek = new HesapKaydetIstegi(_kod, _ad, _tur, _paraBirimi, _bankaAdi, _sube, _hesapNo, _iban, _limit, _aciklama, _bankaHesapTuru,
            SubeId: _subeId, HesapKesimGunu: _hesapKesimGunu, SonOdemeGunu: _sonOdemeGunu,
            PosCalismaSekli: _posCalismaSekli, PosKomisyonOrani: _posKomisyonOrani, PosGunSayisi: _posGunSayisi, PosGunTipi: _posGunTipi,
            PosAktarilacakHesapId: _posAktarilacakHesapId, PosTerminalNo: _posTerminalNo, PosBatchNo: _posBatchNo, Surum: _surum);
        var sonuc = Id is { } id
            ? await Api.PutAsync<HesapDetayi>($"api/kasabanka/hesaplar/{id}", istek, islemAnahtari: _anahtar.Deger)
            : await Api.PostAsync<HesapDetayi>("api/kasabanka/hesaplar", istek, islemAnahtari: _anahtar.Deger);
            _anahtar.Sonuc(sonuc.Hata);
        if (!sonuc.BasariliMi)
        {
            _hata = sonuc.Hata;
            return;
        }

        Snackbar.Add(Id is null ? $"{sonuc.Deger.Kod} kodlu hesap açıldı." : "Hesap güncellendi.", Severity.Success);
        Navigasyon.NavigateTo($"kasabanka/{sonuc.Deger.Id}");
    }
}
