@page "/cari/{Id:guid}"
@inject ApiIstemcisi Api
@inject NavigationManager Navigasyon
@inject IDialogService DialogService
@inject OnayServisi Onay
@inject ISnackbar Snackbar
@inject OturumYoneticisi Oturum

<HataGosterimi Hata="_hata" />

@if (_cari is { } cari)
{
    var dovizliMi = cari.ParaBirimi != ParaBirimleri.Tl;
    var cekRiski = _cekRiskleri.FirstOrDefault(r => r.ParaBirimi == cari.ParaBirimi);
    var toplamRisk = Math.Max(cari.Bakiye, 0) + (cekRiski is null ? 0 : cekRiski.Portfoyde + cekRiski.CiroRiski);
    var riskOrani = cari.RiskLimiti is > 0 ? (double)(toplamRisk / cari.RiskLimiti.Value) * 100 : 0;

    <SayfaBasligi Baslik="@cari.Unvan" GeriAdres="cari" Ikon="@Icons.Material.Filled.Person">
        <AltIcerik>
            <span>@cari.Kod · @CariMetinleri.Tur(cari.Tur) · @ParaBirimleri.Ad(cari.ParaBirimi)</span>
            @if (cari.GrupAdi is not null)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" Class="ml-2">@cari.GrupAdi</MudChip>
            }
            @if (!cari.AktifMi)
            {
                <MudChip T="string" Size="Size.Small" Class="ml-1">Pasif</MudChip>
            }
        </AltIcerik>
        <Islemler>
            <DegisiklikGecmisiDugmesi Modul="cari" KayitId="Id" />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Description" Href="@($"cari/{cari.Id}/ekstre")">Ekstre</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Handshake" Href="@($"cari/{cari.Id}/mutabakat")">Mutabakat</MudButton>
            @if (cari.Tur != CariTuru.Tedarikci)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Percent" Href="@($"cari/{cari.Id}/vade-farki")">Vade Farkı</MudButton>
            }
            @if (Oturum.YazabilirMi("fatura.belge.ekle") && cari.AktifMi && Oturum.ModulAcikMi(ModulKodlari.Fatura))
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ReceiptLong"
                           Href="@($"fatura/yeni/{(cari.Tur == CariTuru.Tedarikci ? "alis" : "satis")}?cari={cari.Id}")">Fatura Kes</MudButton>
            }
            @if (Oturum.YazabilirMi("kasabanka.islem.ekle") && cari.AktifMi && Oturum.ModulAcikMi(ModulKodlari.KasaBanka))
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CallReceived" Href="@KasaIslemAdresi("tahsilat", cari)">Tahsilat</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CallMade" Href="@KasaIslemAdresi("odeme", cari)">Ödeme</MudButton>
            }
            @if (Oturum.YazabilirMi("kasabanka.cek.ekle") && cari.AktifMi && Oturum.ModulAcikMi(ModulKodlari.KasaBanka))
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RequestQuote" Href="@($"cek-senet/giris?cari={cari.Id}&donus=cari/{cari.Id}")">Çek/senet al</MudButton>
            }
            @if (Oturum.YazabilirMi(CariYetkileri.Hareket, YetkiIslemleri.Ekle))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PostAdd"
                           Disabled="!cari.AktifMi" OnClick="HareketEkleAsync">Hareket Ekle</MudButton>
            }
            @if (Oturum.YazabilirMi(CariYetkileri.Hesap, YetkiIslemleri.Duzenle))
            {
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" aria-label="Diğer işlemler" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" Href="@($"cari/{cari.Id}/duzenle")">Düzenle</MudMenuItem>
                    @if (cari.AktifMi)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Block" OnClick="() => DurumDegistirAsync(false)">Pasifleştir</MudMenuItem>
                    }
                    else
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.CheckCircle" OnClick="() => DurumDegistirAsync(true)">Aktifleştir</MudMenuItem>
                    }
                    @if (!cari.HareketVarMi && Oturum.YazabilirMi(CariYetkileri.Hesap, YetkiIslemleri.Sil))
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="SilAsync">Sil</MudMenuItem>
                    }
                </MudMenu>
            }
        </Islemler>
    </SayfaBasligi>

    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="4">
            <div class="panel-kart kart kart-hover belirme" style="--i:0; --vurgu:@(cari.Bakiye > 0 ? "#EF4444" : "#14B8A6")">
                <div class="ozet-baslik mb-2">Bakiye</div>
                <BakiyeGosterimi Bakiye="cari.Bakiye" ParaBirimi="@cari.ParaBirimi" Buyuk="true" />
                @if (dovizliMi)
                {
                    <div class="ozet-alt">Kayıtlı TL karşılığı: @Bicim.Bakiye(cari.BakiyeTl, ParaBirimleri.Tl)</div>
                }
                else
                {
                    <div class="ozet-alt">@(cari.Bakiye > 0 ? "Cari bize borçlu" : cari.Bakiye < 0 ? "Cariye borcumuz var" : "Hesap kapalı")</div>
                }
            </div>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <div class="panel-kart kart kart-hover belirme" style="--i:1; --vurgu:#F59E0B">
                <div class="ozet-baslik mb-2">Risk limiti</div>
                <div class="ozet-deger" style="font-size:1.4rem">@(cari.RiskLimiti is { } limit ? Bicim.Tutar(limit, cari.ParaBirimi) : "Tanımsız")</div>
                @if (cari.RiskLimiti is > 0)
                {
                    <MudProgressLinear Value="@Math.Min(riskOrani, 100)" Rounded="true" Size="Size.Medium" Class="mt-3"
                                       Color="@(riskOrani > 100 ? Color.Error : riskOrani > 80 ? Color.Warning : Color.Success)" />
                    <div class="ozet-alt">
                        @(riskOrani > 100 ? $"Limit {Bicim.Tutar(toplamRisk - cari.RiskLimiti!.Value, cari.ParaBirimi)} aşıldı" : $"Limitin %{riskOrani:0} kullanılıyor")
                    </div>
                }
                @foreach (var r in _cekRiskleri.Where(r => r.Portfoyde + r.CiroRiski + r.Karsiliksiz + r.VerilenAcik > 0))
                {
                    <div class="cek-riski">
                        <a href="@($"cek-senet?cari={cari.Id}")" class="baglanti"><MudIcon Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Small" /> Çek/senet @r.ParaBirimi</a>
                        @if (r.Portfoyde > 0)
                        {
                            <span>Portföyde <b>@Bicim.Tutar(r.Portfoyde, r.ParaBirimi)</b></span>
                        }
                        @if (r.CiroRiski > 0)
                        {
                            <span>Ciro riski <b>@Bicim.Tutar(r.CiroRiski, r.ParaBirimi)</b></span>
                        }
                        @if (r.Karsiliksiz > 0)
                        {
                            <span class="bakiye-borclu">Karşılıksız <b>@Bicim.Tutar(r.Karsiliksiz, r.ParaBirimi)</b></span>
                        }
                        @if (r.VerilenAcik > 0)
                        {
                            <span>Verilen açık <b>@Bicim.Tutar(r.VerilenAcik, r.ParaBirimi)</b></span>
                        }
                    </div>
                }
                @if (cari.VadeGun is { } vade)
                {
                    <div class="ozet-alt">Vade: @vade gün</div>
                }
            </div>
        </MudItem>
        <MudItem xs="12" md="4">
            <div class="panel-kart kart kart-hover belirme" style="--i:2; --vurgu:#3B82F6">
                <div class="ozet-baslik mb-2">İletişim</div>
                @foreach (var (ikon, metin) in Iletisim(cari))
                {
                    <div class="d-flex align-center gap-2 mb-1">
                        <MudIcon Icon="@ikon" Size="Size.Small" Style="opacity:.6" />
                        <span style="font-size:.9rem">@metin</span>
                    </div>
                }
                @if (!Iletisim(cari).Any())
                {
                    <div class="ozet-alt">İletişim bilgisi girilmemiş.</div>
                }
            </div>
        </MudItem>
    </MudGrid>

    <div class="tur-sekmeleri belirme" style="--i:3">
        <button type="button" class="tur-sekmesi @(_acikKalemGorunumu ? "" : "secili")" style="--vurgu:#3B82F6" @onclick="() => _acikKalemGorunumu = false">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" /> Hareketler
        </button>
        <button type="button" class="tur-sekmesi @(_acikKalemGorunumu ? "secili" : "")" style="--vurgu:#F59E0B" @onclick="AcikKalemleriGosterAsync">
            <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Small" /> Açık kalemler@(_acikKalemler is { } ak ? $" ({ak.Count})" : "")
        </button>
    </div>

    @if (_acikKalemGorunumu)
    {
        var borcKalan = _acikKalemler?.Where(k => k.Yon == HareketYonu.Borc).Sum(k => k.Kalan) ?? 0m;
        var alacakKalan = _acikKalemler?.Where(k => k.Yon == HareketYonu.Alacak && !k.AvansMi).Sum(k => k.Kalan) ?? 0m;
        var gecikmis = _acikKalemler?.Where(k => k.Yon == HareketYonu.Borc && k.GecikmeGun > 0 && !k.AvansMi).Sum(k => k.Kalan) ?? 0m;
        var alinanAvans = _acikKalemler?.Where(k => k.AvansMi && k.Yon == HareketYonu.Alacak).Sum(k => k.Kalan) ?? 0m;
        var verilenAvans = _acikKalemler?.Where(k => k.AvansMi && k.Yon == HareketYonu.Borc).Sum(k => k.Kalan) ?? 0m;
        <div class="d-flex flex-wrap gap-6 mb-3 belirme">
            <div><div class="ozet-baslik">Ödenmemiş borç kalemleri</div><b class="bakiye-borclu">@Bicim.Tutar(borcKalan - verilenAvans, cari.ParaBirimi)</b></div>
            <div><div class="ozet-baslik">Bunun vadesi geçen</div><b class="@(gecikmis > 0 ? "bakiye-borclu" : "")">@Bicim.Tutar(gecikmis, cari.ParaBirimi)</b></div>
            <div><div class="ozet-baslik">Dağıtılmamış alacak (fazla tahsilat / ödenmemiş alış)</div><b class="bakiye-alacakli">@Bicim.Tutar(alacakKalan, cari.ParaBirimi)</b></div>
            @if (alinanAvans > 0)
            {
                <div><div class="ozet-baslik">Alınan sipariş avansı</div><b class="bakiye-alacakli">@Bicim.Tutar(alinanAvans, cari.ParaBirimi)</b></div>
            }
            @if (verilenAvans > 0)
            {
                <div><div class="ozet-baslik">Verilen sipariş avansı</div><b class="bakiye-borclu">@Bicim.Tutar(verilenAvans, cari.ParaBirimi)</b></div>
            }
        </div>
        <VeriTablosu T="AcikKalem" Kayitlar="_acikKalemler" Dense="true" BosIkon="@Icons.Material.Outlined.TaskAlt" BosBaslik="Açık kalem yok"
                     BosAciklama="Tüm faturalar ve tahsilatlar birbirini kapatmış.">
            <Basliklar>
                <MudTh>Tarih</MudTh>
                <MudTh>Kalem</MudTh>
                <MudTh>Vade</MudTh>
                <MudTh Class="sayi">Tutar</MudTh>
                <MudTh Class="sayi">Kapanan</MudTh>
                <MudTh Class="sayi">Kalan</MudTh>
                <MudTh></MudTh>
            </Basliklar>
            <Satir>
                <MudTd DataLabel="Tarih">@Bicim.Tarih(context.Tarih)</MudTd>
                <MudTd DataLabel="Kalem">
                    @CariMetinleri.HareketTuru(context.Tur)
                    @if (context.AvansMi)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Class="ml-1">Sipariş avansı</MudChip>
                    }
                    <span class="mobil-alt-bilgi"><BelgeBaglantisi KaynakBelgeId="context.KaynakBelgeId" FaturaMi="CariMetinleri.FaturaHareketiMi(context.Tur)" Metin="@context.BelgeNo" /></span>
                </MudTd>
                <MudTd DataLabel="Vade">
                    @Bicim.Tarih(context.VadeTarihi)
                    @if (context.Yon == HareketYonu.Borc && context.GecikmeGun > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.GecikmeGun > 60 ? Color.Error : Color.Warning)" Class="ml-1">@context.GecikmeGun gün gecikti</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Tutar" Class="sayi">@Bicim.Tutar(context.Tutar)</MudTd>
                <MudTd DataLabel="Kapanan" Class="sayi">@(context.Kapanan > 0 ? Bicim.Tutar(context.Kapanan) : "")</MudTd>
                <MudTd DataLabel="Kalan" Class="sayi">
                    <b class="@(context.Yon == HareketYonu.Borc ? "bakiye-borclu" : "bakiye-alacakli")">@Bicim.Tutar(context.Kalan)</b>
                    @if (context.ElleKapamaMi && !context.AvansMi)
                    {
                        <span class="mobil-alt-bilgi">elle</span>
                    }
                </MudTd>
                <MudTd Style="text-align:right">
                    <MudIconButton Icon="@Icons.Material.Filled.Link" Size="Size.Small" aria-label="Kapamalar" OnClick="() => KapamaAcAsync(context)" />
                </MudTd>
            </Satir>
        </VeriTablosu>
    }
    else
    {
    <VeriTablosu T="CariHareketSatiri" Kayitlar="_hareketler?.Kayitlar" Yukleniyor="_hareketlerYukleniyor" Dense="true"
                 Sayfa="_sayfa" ToplamSayfa="_hareketler?.ToplamSayfa ?? 0" SayfaDegisti="SayfaDegistiAsync"
                 BosIkon="@Icons.Material.Outlined.ReceiptLong" BosBaslik="Henüz hareket yok"
                 BosAciklama="Başka bir programdan geçiyorsanız açılış bakiyesi girerek başlayabilirsiniz.">
        <Basliklar>
            <MudTh>Tarih</MudTh>
            <MudTh>Tür</MudTh>
            <MudTh>Belge No</MudTh>
            <MudTh>Açıklama</MudTh>
            <MudTh>Vade</MudTh>
            <MudTh Class="sayi">Borç</MudTh>
            <MudTh Class="sayi">Alacak</MudTh>
            @if (dovizliMi)
            {
                <MudTh Class="sayi">Kur</MudTh>
                <MudTh Class="sayi">TL</MudTh>
            }
            <MudTh></MudTh>
        </Basliklar>
        <Satir>
            <MudTd DataLabel="Tarih">@Bicim.Tarih(context.Tarih)</MudTd>
            <MudTd DataLabel="Tür">
                @CariMetinleri.HareketTuru(context.Tur)
                @if (context.IptalKaydiMi)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="ml-1">İptal kaydı</MudChip>
                }
                else if (context.IptalEdildiMi)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ml-1">İptal edildi</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Belge No"><BelgeBaglantisi KaynakBelgeId="context.KaynakBelgeId" FaturaMi="CariMetinleri.FaturaHareketiMi(context.Tur)" Metin="@context.BelgeNo" /></MudTd>
            <MudTd DataLabel="Açıklama">@context.Aciklama</MudTd>
            <MudTd DataLabel="Vade">@Bicim.Tarih(context.VadeTarihi)</MudTd>
            <MudTd DataLabel="Borç" Class="sayi"><span class="bakiye-borclu">@(context.Borc > 0 ? Bicim.Tutar(context.Borc) : "")</span></MudTd>
            <MudTd DataLabel="Alacak" Class="sayi"><span class="bakiye-alacakli">@(context.Alacak > 0 ? Bicim.Tutar(context.Alacak) : "")</span></MudTd>
            @if (dovizliMi)
            {
                <MudTd DataLabel="Kur" Class="sayi">@Bicim.Kur(context.Kur)</MudTd>
                <MudTd DataLabel="TL" Class="sayi">@Bicim.Tutar(context.BorcTl + context.AlacakTl)</MudTd>
            }
            <MudTd Style="text-align: right;">
                @if (!context.IptalEdildiMi && !context.IptalKaydiMi)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Link" Size="Size.Small" aria-label="Kapamalar" OnClick="() => KapamaAcAsync(Kalem(context))" />
                }
                @if (context.ElleIptalEdilebilirMi && Oturum.YazabilirMi(CariYetkileri.Hareket, YetkiIslemleri.Iptal))
                {
                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => IptalEtAsync(context)">İptal</MudButton>
                }
            </MudTd>
        </Satir>
        <BosIslemler>
            @if (Oturum.YazabilirMi(CariYetkileri.Hareket, YetkiIslemleri.Ekle) && cari.AktifMi)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PostAdd" OnClick="HareketEkleAsync">Hareket Ekle</MudButton>
            }
        </BosIslemler>
    </VeriTablosu>
    }
}
else if (_hata is null)
{
    <MudSkeleton Height="56px" Width="40%" Animation="Animation.Wave" />
    <MudGrid Spacing="3" Class="my-2">
        @for (var i = 0; i < 3; i++)
        {
            <MudItem xs="12" md="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="140px" Animation="Animation.Wave" Class="rounded-lg" /></MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CariDetayi? _cari;
    private List<CekRiski> _cekRiskleri = [];
    private SayfaliSonuc<CariHareketSatiri>? _hareketler;
    private int _sayfa = 1;
    private bool _hareketlerYukleniyor;
    private bool _acikKalemGorunumu;
    private List<AcikKalem>? _acikKalemler;
    private ApiHatasi? _hata;

    private static string KasaIslemAdresi(string tur, CariDetayi cari) =>
        $"kasabanka/islem/{tur}?cari={cari.Id}&donus={Uri.EscapeDataString($"cari/{cari.Id}")}";

    // Hareket satırından kapama diyaloğu için kalem bilgisi (kapanmış kalemlerin de eşleşmeleri görülebilsin).
    private static AcikKalem Kalem(CariHareketSatiri h) => new(
        h.Id, h.Tarih, h.VadeTarihi, h.Tur, h.Borc > 0 ? HareketYonu.Borc : HareketYonu.Alacak, h.BelgeNo, h.Aciklama,
        h.Borc + h.Alacak, 0m, 0m, 0, false, h.KaynakBelgeId);

    private async Task AcikKalemleriGosterAsync()
    {
        _acikKalemGorunumu = true;
        await AcikKalemleriYukleAsync();
    }

    private async Task AcikKalemleriYukleAsync()
    {
        var sonuc = await Api.GetAsync<List<AcikKalem>>($"api/cari/hesaplar/{Id}/acik-kalemler");
        _acikKalemler = sonuc.BasariliMi ? sonuc.Deger : [];
    }

    private async Task KapamaAcAsync(AcikKalem kalem)
    {
        var parametreler = new DialogParameters<KapamaDialog>
        {
            { d => d.Kalem, kalem },
            { d => d.CariId, Id },
            { d => d.ParaBirimi, _cari!.ParaBirimi }
        };
        var dialog = await DialogService.ShowAsync<KapamaDialog>(
            $"Kapamalar · {CariMetinleri.HareketTuru(kalem.Tur)} {kalem.BelgeNo}", parametreler, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Kapamalar güncellendi.", Severity.Success);
            await AcikKalemleriYukleAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await CariYukleAsync();
        await HareketleriYukleAsync();
    }

    private static IEnumerable<(string Ikon, string Metin)> Iletisim(CariDetayi c)
    {
        if (c.Telefon is not null) yield return (Icons.Material.Filled.Phone, c.Telefon);
        if (c.Eposta is not null) yield return (Icons.Material.Filled.Email, c.Eposta);
        if (c.YetkiliAd is not null) yield return (Icons.Material.Filled.Person, $"{c.YetkiliAd} {c.YetkiliTelefon}".Trim());
        var adres = string.Join(", ", new[] { c.Adres, c.Ilce, c.Il }.Where(x => !string.IsNullOrEmpty(x)));
        if (adres.Length > 0) yield return (Icons.Material.Filled.Place, adres);
        if (c.VergiNo is not null) yield return (Icons.Material.Filled.Badge, $"{(c.VergiNo.Length == 11 ? "TCKN" : "VKN")} {c.VergiNo} {c.VergiDairesi}".Trim());
    }

    private async Task CariYukleAsync()
    {
        var sonuc = await Api.GetAsync<CariDetayi>($"api/cari/hesaplar/{Id}");
        _hata = sonuc.Hata;
        _cari = sonuc.BasariliMi ? sonuc.Deger : null;
        if (_cari is not null && Oturum.ModulAcikMi(ModulKodlari.KasaBanka))
        {
            var risk = await Api.GetAsync<List<CekRiski>>($"api/kasabanka/cek-senet/cari-riski/{Id}");
            _cekRiskleri = risk.BasariliMi ? risk.Deger : [];
        }
    }

    private async Task HareketleriYukleAsync()
    {
        _hareketlerYukleniyor = true;
        var sonuc = await Api.GetAsync<SayfaliSonuc<CariHareketSatiri>>($"api/cari/hesaplar/{Id}/hareketler?sayfa={_sayfa}");
        _hareketler = sonuc.BasariliMi ? sonuc.Deger : new SayfaliSonuc<CariHareketSatiri>([], 1, 20, 0);
        _hareketlerYukleniyor = false;
    }

    private async Task SayfaDegistiAsync(int sayfa)
    {
        _sayfa = sayfa;
        await HareketleriYukleAsync();
    }

    private async Task YenileAsync()
    {
        _sayfa = 1;
        await CariYukleAsync();
        await HareketleriYukleAsync();
        _acikKalemler = null;
        if (_acikKalemGorunumu)
        {
            await AcikKalemleriYukleAsync();
        }
    }

    private async Task HareketEkleAsync()
    {
        var parametreler = new DialogParameters<HareketDialog> { { d => d.Cari, _cari! } };
        var dialog = await DialogService.ShowAsync<HareketDialog>("Hareket Ekle", parametreler, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Hareket kaydedildi.", Severity.Success);
            await YenileAsync();
        }
    }

    private async Task IptalEtAsync(CariHareketSatiri hareket)
    {
        if (!await Onay.SorAsync("Hareketi iptal et",
                $"{Bicim.Tarih(hareket.Tarih)} tarihli {CariMetinleri.HareketTuru(hareket.Tur).ToLower(CultureInfo.CurrentCulture)} için ters kayıt atılacak. Orijinal kayıt silinmez.",
                "İptal et", tehlikeli: true))
        {
            return;
        }

        var sonuc = await Api.PostAsync($"api/cari/hareketler/{hareket.Id}/iptal");
        if (sonuc.BasariliMi)
        {
            Snackbar.Add("Hareket iptal edildi.", Severity.Success);
            await YenileAsync();
        }
        else
        {
            Snackbar.Add(sonuc.Hata.Baslik, Severity.Error);
        }
    }

    private async Task DurumDegistirAsync(bool aktif)
    {
        var sonuc = await Api.PostAsync($"api/cari/hesaplar/{Id}/{(aktif ? "aktiflestir" : "pasiflestir")}");
        if (sonuc.BasariliMi)
        {
            Snackbar.Add(aktif ? "Cari aktifleştirildi." : "Cari pasifleştirildi.", Severity.Success);
            await CariYukleAsync();
        }
        else
        {
            Snackbar.Add(sonuc.Hata.Baslik, Severity.Error);
        }
    }

    private async Task SilAsync()
    {
        if (!await Onay.SorAsync("Cariyi sil", $"{_cari!.Unvan} silinecek. Bu işlem geri alınamaz.", "Sil", tehlikeli: true))
        {
            return;
        }

        var sonuc = await Api.DeleteAsync($"api/cari/hesaplar/{Id}");
        if (sonuc.BasariliMi)
        {
            Snackbar.Add("Cari silindi.", Severity.Success);
            Navigasyon.NavigateTo("cari");
        }
        else
        {
            Snackbar.Add(sonuc.Hata.Baslik, Severity.Error);
        }
    }
}
