@page "/cari/{Id:guid}/ekstre"
@inject ApiIstemcisi Api
@inject IJSRuntime Js
@inject TimeProvider Zaman
@inject OturumYoneticisi Oturum

<SayfaBasligi Baslik="Cari Ekstre" AltBaslik="@(_ekstre is { } e0 ? $"{e0.Kod} - {e0.Unvan}" : null)" GeriAdres="@($"cari/{Id}")" Ikon="@Icons.Material.Filled.Description">
    <Islemler>
    <MudDatePicker Variant="Variant.Outlined" @bind-Date="_baslangic" Label="Başlangıç" Style="max-width: 160px;" Margin="Margin.Dense" />
    <MudDatePicker Variant="Variant.Outlined" @bind-Date="_bitis" Label="Bitiş" Style="max-width: 160px;" Margin="Margin.Dense" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="YukleAsync">Göster</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" Disabled="_ekstre is null" OnClick="YazdirAsync">Yazdır</MudButton>
    @if (_ekstre is { } paylasilan)
    {
        <ExcelAktarDugmesi T="EkstreSatiri" Ad="@($"Cari ekstresi {paylasilan.Kod}")" Kayitlar="_excelSatirlari"
                           Kolonlar="@(paylasilan.ParaBirimi == ParaBirimleri.Tl ? _excelKolonlari : _dovizliExcelKolonlari)" />
        <WhatsAppDugmesi Telefon="@_telefon" Metin="@WhatsAppMetni(paylasilan)" />
    }
    </Islemler>
</SayfaBasligi>

<HataGosterimi Hata="_hata" />

@if (_yukleniyor)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="360px" Animation="Animation.Wave" Class="rounded-lg" />
}
else if (_ekstre is { } e)
{
    var dovizliMi = e.ParaBirimi != ParaBirimleri.Tl;

    <div class="mb-3 sadece-yazdir">
        <MudText Typo="Typo.subtitle2">@Oturum.Bilgi?.AktifFirma?.Unvan</MudText>
        <MudText Typo="Typo.h6">@e.Kod - @e.Unvan</MudText>
        <MudText Typo="Typo.body2">@Bicim.Tarih(e.Baslangic) – @Bicim.Tarih(e.Bitis) · @ParaBirimleri.Ad(e.ParaBirimi)</MudText>
    </div>

    <div class="kart belirme pa-2" style="overflow-x:auto">
    <MudSimpleTable Dense="true" Hover="true" Elevation="0">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>Tür</th>
                <th>Belge No</th>
                <th>Açıklama</th>
                <th>Vade</th>
                <th class="sayi">Borç</th>
                <th class="sayi">Alacak</th>
                <th class="sayi">Bakiye</th>
                @if (dovizliMi)
                {
                    <th class="sayi">Kur</th>
                    <th class="sayi">Bakiye (TL)</th>
                }
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="7"><i>Devreden bakiye</i></td>
                <td class="sayi">@Bicim.Bakiye(e.DevirBakiye, e.ParaBirimi)</td>
                @if (dovizliMi)
                {
                    <td></td>
                    <td class="sayi">@Bicim.Bakiye(e.DevirBakiyeTl, ParaBirimleri.Tl)</td>
                }
            </tr>
            @foreach (var s in e.Satirlar)
            {
                <tr>
                    <td>@Bicim.Tarih(s.Tarih)</td>
                    <td>@CariMetinleri.HareketTuru(s.Tur)</td>
                    <td><BelgeBaglantisi KaynakBelgeId="s.KaynakBelgeId" FaturaMi="CariMetinleri.FaturaHareketiMi(s.Tur)" Metin="@s.BelgeNo" /></td>
                    <td>@s.Aciklama</td>
                    <td>@Bicim.Tarih(s.VadeTarihi)</td>
                    <td class="sayi">@(s.Borc > 0 ? Bicim.Tutar(s.Borc) : "")</td>
                    <td class="sayi">@(s.Alacak > 0 ? Bicim.Tutar(s.Alacak) : "")</td>
                    <td class="sayi">@Bicim.Bakiye(s.Bakiye, e.ParaBirimi)</td>
                    @if (dovizliMi)
                    {
                        <td class="sayi">@Bicim.Kur(s.Kur)</td>
                        <td class="sayi">@Bicim.Bakiye(s.BakiyeTl, ParaBirimleri.Tl)</td>
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr style="font-weight: 600;">
                <td colspan="5">Dönem toplamı</td>
                <td class="sayi">@Bicim.Tutar(e.ToplamBorc)</td>
                <td class="sayi">@Bicim.Tutar(e.ToplamAlacak)</td>
                <td class="sayi">@Bicim.Bakiye(e.SonBakiye, e.ParaBirimi)</td>
                @if (dovizliMi)
                {
                    <td></td>
                    <td class="sayi">@Bicim.Bakiye(e.SonBakiyeTl, ParaBirimleri.Tl)</td>
                }
            </tr>
        </tfoot>
    </MudSimpleTable>
    </div>

    @if (e.Satirlar.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mt-2">Bu dönemde hareket yok.</MudText>
    }

    <MudText Typo="Typo.caption" Class="mt-2 d-block">(B) borçlu, (A) alacaklı bakiye.</MudText>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private DateTime? _baslangic;
    private DateTime? _bitis;
    private EkstreCevabi? _ekstre;
    private List<EkstreSatiri> _excelSatirlari = [];
    private string? _telefon;
    private bool _yukleniyor;
    private ApiHatasi? _hata;

    // Excel'de ilk satır devreden bakiyedir; HareketId boş olan satır devir satırı sayılır.
    private static bool DevirMi(EkstreSatiri s) => s.HareketId == Guid.Empty;

    private static readonly IReadOnlyList<ExcelKolonu<EkstreSatiri>> _excelKolonlari =
    [
        new("Tarih", s => s.Tarih, 12),
        new("Tür", s => DevirMi(s) ? "Devreden bakiye" : CariMetinleri.HareketTuru(s.Tur), 22),
        new("Belge no", s => s.BelgeNo, 18),
        new("Açıklama", s => s.Aciklama, 40),
        new("Vade", s => s.VadeTarihi, 12),
        new("Borç", s => s.Borc, 16),
        new("Alacak", s => s.Alacak, 16),
        new("Bakiye", s => s.Bakiye, 16),
        new("B/A", s => s.Bakiye > 0 ? "B" : s.Bakiye < 0 ? "A" : null, 6)
    ];

    private static readonly IReadOnlyList<ExcelKolonu<EkstreSatiri>> _dovizliExcelKolonlari =
    [
        .. _excelKolonlari,
        new("Kur", s => DevirMi(s) ? null : s.Kur, 12),
        new("Borç (TL)", s => s.BorcTl, 16),
        new("Alacak (TL)", s => s.AlacakTl, 16),
        new("Bakiye (TL)", s => s.BakiyeTl, 16)
    ];

    protected override async Task OnInitializedAsync()
    {
        var bugun = Zaman.GetLocalNow().Date;
        _baslangic = new DateTime(bugun.Year, 1, 1);
        _bitis = bugun;
        await YukleAsync();
        var cari = await Api.GetAsync<CariDetayi>($"api/cari/hesaplar/{Id}");
        _telefon = cari.BasariliMi ? cari.Deger.UlasimTelefonu : null;
    }

    private async Task YukleAsync()
    {
        _yukleniyor = true;
        var adres = $"api/cari/hesaplar/{Id}/ekstre"
                    + $"?baslangic={Bicim.Iso(DateOnly.FromDateTime(_baslangic ?? DateTime.Today))}"
                    + $"&bitis={Bicim.Iso(DateOnly.FromDateTime(_bitis ?? DateTime.Today))}";
        var sonuc = await Api.GetAsync<EkstreCevabi>(adres);
        _hata = sonuc.Hata;
        _ekstre = sonuc.BasariliMi ? sonuc.Deger : null;
        _excelSatirlari = _ekstre is { } e
            ? [new EkstreSatiri(Guid.Empty, e.Baslangic, null, CariHareketTuru.Acilis, null, null, 0, 0, e.DevirBakiye, 0, 0, 0, e.DevirBakiyeTl, null), .. e.Satirlar]
            : [];
        _yukleniyor = false;
    }

    private async Task YazdirAsync() => await Js.InvokeVoidAsync("print");

    // Ekstrenin özeti; ayrıntılı döküm için yazdırılan ekstre (PDF) ayrıca gönderilebilir.
    private string WhatsAppMetni(EkstreCevabi e)
    {
        var bakiye = e.SonBakiye switch
        {
            > 0 => $"Borç bakiyeniz: {Bicim.Tutar(e.SonBakiye, e.ParaBirimi)}",
            < 0 => $"Alacak bakiyeniz: {Bicim.Tutar(-e.SonBakiye, e.ParaBirimi)}",
            _ => "Hesabınız kapalıdır (bakiye yok)."
        };
        return $"Sayın {e.Unvan},\n{Bicim.Tarih(e.Baslangic)} - {Bicim.Tarih(e.Bitis)} dönemi hesap özetiniz:\n"
               + $"Devir: {Bicim.Tutar(e.DevirBakiye, e.ParaBirimi)}\nBorç: {Bicim.Tutar(e.ToplamBorc, e.ParaBirimi)}\n"
               + $"Alacak: {Bicim.Tutar(e.ToplamAlacak, e.ParaBirimi)}\n{bakiye}\n\n{Oturum.Bilgi?.AktifFirma?.Unvan}";
    }
}
