@page "/cari/yeni"
@page "/cari/{Id:guid}/duzenle"
@inject ApiIstemcisi Api
@inject ZorunluAlanServisi ZorunluAlanlar
@inject NavigationManager Navigasyon
@inject ISnackbar Snackbar

<SayfaBasligi Baslik="@Baslik" GeriAdres="@(Id is null ? "cari" : $"cari/{Id}")" Ikon="@(Id is null ? Icons.Material.Filled.PersonAdd : Icons.Material.Filled.Edit)"
             AltBaslik="@(Id is null ? "Yeni müşteri veya tedarikçi kartı" : _unvan)" />

<HataGosterimi Hata="_hata" />

@if (_yukleniyor)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="420px" Animation="Animation.Wave" Class="rounded-lg" />
}
else
{
    <MudForm @ref="_form">
        <FormBolumu Baslik="Genel bilgiler" Aciklama="Kimlik, vergi ve para birimi" Ikon="@Icons.Material.Filled.Badge" Sira="0">
                <MudItem xs="12" sm="4" md="2">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_kod" Label="Kod" MaxLength="20" HelperText="Boş bırakılırsa otomatik verilir" />
                </MudItem>
                <MudItem xs="12" sm="8" md="6">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_unvan" Label="Ünvan" Required="true" RequiredError="Ünvan gerekli." MaxLength="250" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_tur" Label="Tür">
                        @foreach (var tur in Enum.GetValues<CariTuru>())
                        {
                            <MudSelectItem Value="tur">@CariMetinleri.Tur(tur)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_kisiTipi" Label="Kişi tipi">
                        @foreach (var tip in Enum.GetValues<KisiTipi>())
                        {
                            <MudSelectItem Value="tip">@CariMetinleri.KisiTipi(tip)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_vergiNo" Required="Z(CariZorunluAlanlari.VergiNo)" RequiredError="Bu alan zorunlu (firma ayarı)." MaxLength="11"
                                  Label="@(_kisiTipi == KisiTipi.Sahis ? "T.C. kimlik no" : "Vergi no / T.C. kimlik no")" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_vergiDairesi" Required="Z(CariZorunluAlanlari.VergiDairesi)" RequiredError="Bu alan zorunlu (firma ayarı)." Label="Vergi dairesi" MaxLength="100" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" T="Guid?" @bind-Value="_grupId" Required="Z(CariZorunluAlanlari.Grup)" RequiredError="Bu alan zorunlu (firma ayarı)." Label="Grup" Clearable="true">
                        @foreach (var grup in _gruplar)
                        {
                            <MudSelectItem T="Guid?" Value="grup.Id">@grup.Ad</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_paraBirimi" Label="Para birimi" Disabled="_hareketVarMi"
                               HelperText="@(_hareketVarMi ? "Hareketi olan carinin para birimi değiştirilemez" : null)">
                        @foreach (var pb in ParaBirimleri.Tumu)
                        {
                            <MudSelectItem Value="pb.Kod">@pb.Kod - @pb.Ad</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="5" Class="d-flex align-center">
                    <MudSwitch T="bool" @bind-Value="_farkliDovizdeIslem" Color="Color.Secondary"
                               Label="Farklı dövizde tahsilat/ödeme kabul et" />
                </MudItem>
        </FormBolumu>

        <FormBolumu Baslik="İletişim" Aciklama="Telefon, e-posta, yetkili ve adres" Ikon="@Icons.Material.Filled.ContactPhone" Sira="1">
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_telefon" Required="Z(CariZorunluAlanlari.Telefon)" RequiredError="Bu alan zorunlu (firma ayarı)." Label="Telefon" MaxLength="30" InputType="InputType.Telephone" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_eposta" Required="Z(CariZorunluAlanlari.Eposta)" RequiredError="Bu alan zorunlu (firma ayarı)." Label="E-posta" MaxLength="256" InputType="InputType.Email" />
                </MudItem>
                <MudItem xs="12" sm="6" md="6">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_iban" Required="Z(CariZorunluAlanlari.Iban)" RequiredError="Bu alan zorunlu (firma ayarı)." Label="IBAN" MaxLength="40"
                                  HelperText="Banka ekstresi aktarımında carinin otomatik bulunmasını sağlar" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_yetkiliAd" Required="Z(CariZorunluAlanlari.YetkiliAd)" RequiredError="Bu alan zorunlu (firma ayarı)." Label="Yetkili kişi" MaxLength="100" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_yetkiliTelefon" Required="Z(CariZorunluAlanlari.YetkiliTelefon)" RequiredError="Bu alan zorunlu (firma ayarı)." Label="Yetkili telefonu" MaxLength="30" InputType="InputType.Telephone" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_il" Required="Z(CariZorunluAlanlari.Il)" RequiredError="Bu alan zorunlu (firma ayarı)." Label="İl" MaxLength="50" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_ilce" Required="Z(CariZorunluAlanlari.Ilce)" RequiredError="Bu alan zorunlu (firma ayarı)." Label="İlçe" MaxLength="50" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_adres" Required="Z(CariZorunluAlanlari.Adres)" RequiredError="Bu alan zorunlu (firma ayarı)." Label="Adres" MaxLength="500" />
                </MudItem>
        </FormBolumu>

        <FormBolumu Baslik="Ticari koşullar" Aciklama="Vade, risk limiti ve notlar" Ikon="@Icons.Material.Filled.Handshake" Sira="2">
                <MudItem xs="6" md="3">
                    <MudNumericField Margin="Margin.Dense" Variant="Variant.Outlined" T="int?" @bind-Value="_vadeGun" Required="Z(CariZorunluAlanlari.VadeGun)" RequiredError="Bu alan zorunlu (firma ayarı)." Label="Vade (gün)" Min="0" Max="365" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudNumericField Margin="Margin.Dense" Variant="Variant.Outlined" T="decimal?" @bind-Value="_riskLimiti" Required="Z(CariZorunluAlanlari.RiskLimiti)" RequiredError="Bu alan zorunlu (firma ayarı)." Label="@($"Risk limiti ({_paraBirimi})")" Min="0" Format="N2"
                                     HideSpinButtons="true" HelperText="Bakiye bu tutarı aşınca uyarı verilir" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudNumericField Margin="Margin.Dense" Variant="Variant.Outlined" T="decimal?" @bind-Value="_vadeFarkiOrani" Label="Vade farkı (yıllık %)"
                                     Min="0" Max="500" Format="0.##" HideSpinButtons="true" Adornment="Adornment.End" AdornmentText="%"
                                     HelperText="Geç ödemede uygulanacak sözleşme oranı" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="_not" Label="Not" MaxLength="1000" Lines="2" />
                </MudItem>
        </FormBolumu>
    </MudForm>

    <div class="d-flex gap-2 justify-end">
        <MudButton Href="@(Id is null ? "cari" : $"cari/{Id}")">Vazgeç</MudButton>
        <IslemDugmesi Islem="KaydetAsync" StartIcon="@Icons.Material.Filled.Save">Kaydet</IslemDugmesi>
    </div>
}

@code {
    private readonly IslemAnahtari _anahtar = new();

    [Parameter]
    public Guid? Id { get; set; }

    private string Baslik => Id is null ? "Yeni Cari" : "Cari Düzenle";

    private MudForm _form = null!;
    private List<GrupOzeti> _gruplar = [];
    private string? _kod;
    private string _unvan = "";
    private CariTuru _tur = CariTuru.Musteri;
    private KisiTipi _kisiTipi = KisiTipi.Tuzel;
    private string? _vergiNo;
    private string? _vergiDairesi;
    private string? _il;
    private string? _ilce;
    private string? _adres;
    private string? _telefon;
    private string? _eposta;
    private string? _iban;
    private string _paraBirimi = ParaBirimleri.Tl;
    private int? _vadeGun;
    private decimal? _vadeFarkiOrani;
    private decimal? _riskLimiti;
    private Guid? _grupId;
    private string? _yetkiliAd;
    private string? _yetkiliTelefon;
    private string? _not;
    private bool _farkliDovizdeIslem;
    private uint _surum;
    private bool _hareketVarMi;
    private bool _yukleniyor = true;
    private ApiHatasi? _hata;

    private IReadOnlySet<string> _zorunlu = new HashSet<string>();

    private bool Z(string kod) => _zorunlu.Contains(kod);

    protected override async Task OnInitializedAsync()
    {
        _zorunlu = await ZorunluAlanlar.SeciliAsync();
        var gruplar = await Api.GetAsync<List<GrupOzeti>>("api/cari/gruplar");
        _gruplar = gruplar.BasariliMi ? gruplar.Deger : [];

        if (Id is { } id)
        {
            var sonuc = await Api.GetAsync<CariDetayi>($"api/cari/hesaplar/{id}");
            if (!sonuc.BasariliMi)
            {
                _hata = sonuc.Hata;
                _yukleniyor = false;
                return;
            }

            var c = sonuc.Deger;
            (_kod, _unvan, _tur, _kisiTipi, _vergiNo, _vergiDairesi) = (c.Kod, c.Unvan, c.Tur, c.KisiTipi, c.VergiNo, c.VergiDairesi);
            (_il, _ilce, _adres, _telefon, _eposta) = (c.Il, c.Ilce, c.Adres, c.Telefon, c.Eposta);
            (_paraBirimi, _vadeGun, _riskLimiti, _grupId) = (c.ParaBirimi, c.VadeGun, c.RiskLimiti, c.GrupId);
            (_yetkiliAd, _yetkiliTelefon, _not, _surum, _hareketVarMi) = (c.YetkiliAd, c.YetkiliTelefon, c.Not, c.Surum, c.HareketVarMi);
            _farkliDovizdeIslem = c.FarkliDovizdeIslem;
            _iban = c.Iban;
            _vadeFarkiOrani = c.VadeFarkiOrani;
        }

        _yukleniyor = false;
    }

    private async Task KaydetAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        var istek = new CariKaydetIstegi(
            _kod, _unvan, _tur, _kisiTipi, _vergiNo, _vergiDairesi, _il, _ilce, _adres, _telefon, _eposta,
            _paraBirimi, _vadeGun, _riskLimiti, _grupId, _yetkiliAd, _yetkiliTelefon, _not, _farkliDovizdeIslem, _surum, _iban, _vadeFarkiOrani);
        var sonuc = Id is { } id
            ? await Api.PutAsync<CariDetayi>($"api/cari/hesaplar/{id}", istek, islemAnahtari: _anahtar.Deger)
            : await Api.PostAsync<CariDetayi>("api/cari/hesaplar", istek, islemAnahtari: _anahtar.Deger);
            _anahtar.Sonuc(sonuc.Hata);

        if (sonuc.BasariliMi)
        {
            Snackbar.Add(Id is null ? $"{sonuc.Deger.Kod} kodlu cari oluşturuldu." : "Cari güncellendi.", Severity.Success);
            Navigasyon.NavigateTo($"cari/{sonuc.Deger.Id}");
        }
        else
        {
            _hata = sonuc.Hata;
        }
    }
}
