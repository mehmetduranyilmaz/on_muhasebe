# Tek alan adı: Web (WASM) kökte, API /api altında. Alan adı gerçekse sertifika Let's Encrypt'ten otomatik alınır;
# ALAN_ADI=localhost ile yerelde Caddy'nin kendi sertifikası kullanılır.
{
	email {$ACME_EPOSTA}
}

{$ALAN_ADI} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# API kendi güvenlik başlıklarını (katı CSP, no-store) verir; gerçek istemci IP'si X-Forwarded-For ile iletilir.
	@api path /api/* /health
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "same-origin"
			Cross-Origin-Opener-Policy "same-origin"
			# Kamera yalnızca kendi sayfalarımızda (çek karekodu okutma).
			Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		}
		import csp.caddy

		# Uygulama kabuğu her açılışta güncel mi diye sorulur; sürümlü (_framework) dosyaları tarayıcı önbellekler.
		@kabuk path / /index.html /service-worker.js /service-worker-assets.js /manifest.webmanifest
		header @kabuk Cache-Control "no-cache"
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}

	log {
		output stdout
		format console
	}
}
